---
import GhostLink from "@/components/shared/GhostLink.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { speakers as defaultSpeakers } from "@/data/speakers";
import type { Speaker } from "@/types/speakers";
import { withBase } from "@/utils/path";

interface Props {
  speakers?: Speaker[];
  eyebrow?: string;
  heading?: string;
  viewAllHref?: string;
  viewAllLabel?: string;
}

const {
  speakers = defaultSpeakers,
  eyebrow = "Ponentes",
  heading = "Los referentes detrás del tech que usas",
  viewAllHref = "#speakers-heading",
  viewAllLabel = "Ver todos los ponentes",
} = Astro.props;

const hasSpeakers = speakers.length > 0;
---

<Section
  class="bg-page !pt-size-8 !pb-size-6 lg:!pt-size-10 lg:!pb-size-8"
  ariaLabelledby="speakers-heading"
>
  <Container>
    <div data-speakers-section>
      <header class="py-size-8 lg:pb-size-8 lg:pt-0">
        <p
          class="type-eyebrow-medium pb-size-6 font-body uppercase text-highlighted"
        >
          {eyebrow}
        </p>

        <h2 id="speakers-heading" class="type-h2 max-w-[700px] font-display">
          {heading}
        </h2>
      </header>

      {
        hasSpeakers ? (
          <>
            <div class="flex items-center justify-between pb-size-6 pt-size-4 lg:justify-end lg:gap-[20px] lg:pb-size-8">
              <div
                class="flex items-center gap-[4px] font-body text-[14px] font-medium leading-[1.2] tracking-[0] text-[#D5CABF] tabular-nums lg:text-[20px]"
                aria-live="polite"
                aria-atomic="true"
              >
                <span data-speaker-counter>1</span>
                <span>de</span>
                <span>{speakers.length}</span>
              </div>

              <div class="flex items-center gap-[12px] lg:gap-[16px]">
                <Button
                  variant="secondary"
                  size="default"
                  type="button"
                  aria-label="Ponente anterior"
                  class="speaker-prev h-[30px] min-h-[30px] max-h-[30px] w-[74px] min-w-[74px] max-w-[74px] flex-none rounded-none border border-[#272421] bg-[#272421] p-0 text-stone-400 transition-colors cursor-pointer hover:bg-[var(--palette-amber-100)] hover:border-[var(--palette-amber-100)] hover:text-[#1A1814] active:bg-[var(--palette-amber-100)] active:border-[var(--palette-amber-100)] active:text-white disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-[#272421] disabled:hover:border-[#272421] disabled:hover:text-stone-400 lg:h-[43px] lg:min-h-[43px] lg:max-h-[43px] lg:w-[107px] lg:min-w-[107px] lg:max-w-[107px]"
                >
                  <span class="flex h-full w-full items-center justify-center opacity-90">
                    <svg
                      width="25.5"
                      height="25.5"
                      viewBox="0 0 256 256"
                      fill="none"
                      class="h-[18px] w-[18px] rotate-180 lg:h-[25.5px] lg:w-[25.5px]"
                      aria-hidden="true"
                    >
                      <path
                        d="M40 128H216M144 56L216 128L144 200"
                        stroke="currentColor"
                        stroke-width="8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </Button>

                <Button
                  variant="secondary"
                  size="default"
                  type="button"
                  aria-label="Siguiente ponente"
                  class="speaker-next h-[30px] min-h-[30px] max-h-[30px] w-[74px] min-w-[74px] max-w-[74px] flex-none rounded-none border border-[#272421] bg-[#272421] p-0 text-stone-400 transition-colors cursor-pointer hover:bg-[var(--palette-amber-100)] hover:border-[var(--palette-amber-100)] hover:text-[#1A1814] active:bg-[var(--palette-amber-100)] active:border-[var(--palette-amber-100)] active:text-white disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-[#272421] disabled:hover:border-[#272421] disabled:hover:text-stone-400 lg:h-[43px] lg:min-h-[43px] lg:max-h-[43px] lg:w-[107px] lg:min-w-[107px] lg:max-w-[107px]"
                >
                  <span class="flex h-full w-full items-center justify-center opacity-90">
                    <svg
                      width="25.5"
                      height="25.5"
                      viewBox="0 0 256 256"
                      fill="none"
                      class="h-[18px] w-[18px] lg:h-[25.5px] lg:w-[25.5px]"
                      aria-hidden="true"
                    >
                      <path
                        d="M40 128H216M144 56L216 128L144 200"
                        stroke="currentColor"
                        stroke-width="8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </Button>
              </div>
            </div>

            <div
              class="speaker-carousel flex gap-[16px] lg:gap-[24px] h-[388px] w-full cursor-grab select-none overflow-x-auto snap-x snap-mandatory scroll-smooth py-size-2 [-ms-overflow-style:none] [scrollbar-width:none] active:cursor-grabbing lg:h-[424px] lg:pb-size-4 lg:pt-size-2 [&::-webkit-scrollbar]:hidden"
              role="region"
              aria-label="Carrusel de ponentes"
            >
              {speakers.map((speaker) => (
                <article
                  id={`speaker-${speaker.id}`}
                  class="flex h-[388px] min-h-[388px] w-[274px] flex-none snap-start flex-col overflow-hidden rounded-none border border-[#272421] bg-[#1A1814] lg:h-[424px] lg:min-h-[424px] lg:w-[300px]"
                  data-speaker-card
                >
                  <img
                    src={withBase(speaker.image)}
                    alt={`Retrato de ${speaker.name} ${speaker.lastName}`}
                    width="274"
                    height="274"
                    class="pointer-events-none h-[274px] w-[274px] flex-none object-cover rounded-none lg:h-[300px] lg:w-[300px]"
                    loading="lazy"
                  />
                  <div class="flex flex-1 flex-col justify-center gap-[4px] p-size-4">
                    <h3 class="w-full font-display text-[20px] font-medium leading-[1.1] tracking-[0] text-heading lg:text-[24px]">
                      {speaker.name} {speaker.lastName}
                    </h3>

                    <div class="flex w-full items-center gap-[4px] font-body text-[14px] text-muted lg:text-[16px]">
                      <span>{speaker.role}</span>
                    </div>
                  </div>
                </article>
              ))}
            </div>

            <div class="flex justify-end pt-size-5 lg:pt-size-8">
              <GhostLink href={viewAllHref} label={viewAllLabel} />
            </div>
          </>
        ) : (
          <p class="py-size-8 type-paragraph-l text-muted">
            No hay ponentes disponibles.
          </p>
        )
      }
    </div>
  </Container>
</Section>

<script>
  function initializeSpeakersCarousels() {
    const sections = document.querySelectorAll<HTMLElement>(
      "[data-speakers-section]"
    );

    sections.forEach((section) => {
      if (section.dataset.initialized === "true") {
        return;
      }

      const carousel = section.querySelector<HTMLElement>(".speaker-carousel");
      const previousButton =
        section.querySelector<HTMLButtonElement>(".speaker-prev");
      const nextButton =
        section.querySelector<HTMLButtonElement>(".speaker-next");
      const counter = section.querySelector<HTMLElement>(
        "[data-speaker-counter]"
      );
      const cards = Array.from(
        section.querySelectorAll<HTMLElement>("[data-speaker-card]")
      );

      if (
        !carousel ||
        !previousButton ||
        !nextButton ||
        !counter ||
        cards.length === 0
      ) {
        return;
      }

      section.dataset.initialized = "true";

      let currentIndex = 0;
      let scrollFrame: number | undefined;

      let isMouseDown = false;
      let startX = 0;
      let scrollLeft = 0;

      const updateControls = () => {
        counter.textContent = String(currentIndex + 1);
        previousButton.disabled = currentIndex === 0;
        nextButton.disabled = currentIndex === cards.length - 1;
      };

      const scrollToCard = (index: number) => {
        currentIndex = Math.max(0, Math.min(index, cards.length - 1));

        carousel.scrollTo({
          left: cards[currentIndex].offsetLeft - carousel.offsetLeft,
          behavior: "smooth",
        });

        updateControls();
      };

      const updateCurrentCard = () => {
        const carouselLeft = carousel.getBoundingClientRect().left;

        let closestIndex = 0;
        let closestDistance = Number.POSITIVE_INFINITY;

        cards.forEach((card, index) => {
          const distance = Math.abs(
            card.getBoundingClientRect().left - carouselLeft
          );

          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });

        if (closestIndex !== currentIndex) {
          currentIndex = closestIndex;
          updateControls();
        }
      };

      carousel.addEventListener("mousedown", (e) => {
        isMouseDown = true;
        carousel.classList.remove("scroll-smooth", "snap-x");
        startX = e.pageX - carousel.offsetLeft;
        scrollLeft = carousel.scrollLeft;
      });

      carousel.addEventListener("mouseleave", () => {
        if (!isMouseDown) return;
        isMouseDown = false;
        carousel.classList.add("scroll-smooth", "snap-x");
      });

      carousel.addEventListener("mouseup", () => {
        if (!isMouseDown) return;
        isMouseDown = false;
        carousel.classList.add("scroll-smooth", "snap-x");
      });

      carousel.addEventListener("mousemove", (e) => {
        if (!isMouseDown) return;
        e.preventDefault();
        const x = e.pageX - carousel.offsetLeft;
        const walk = (x - startX) * 1.5;
        carousel.scrollLeft = scrollLeft - walk;
      });

      previousButton.addEventListener("click", () => {
        scrollToCard(currentIndex - 1);
      });

      nextButton.addEventListener("click", () => {
        scrollToCard(currentIndex + 1);
      });

      carousel.addEventListener(
        "scroll",
        () => {
          if (scrollFrame !== undefined) {
            cancelAnimationFrame(scrollFrame);
          }

          scrollFrame = requestAnimationFrame(updateCurrentCard);
        },
        { passive: true }
      );

      updateControls();
    });
  }

  initializeSpeakersCarousels();

  document.addEventListener("astro:page-load", initializeSpeakersCarousels);
</script>
