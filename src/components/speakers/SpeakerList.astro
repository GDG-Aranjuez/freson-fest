---
import CtaNote from "@/components/shared/CtaNote.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { speakers as defaultSpeakers } from "@/data/speakers";
import type { Speaker } from "@/types/speakers";
import { withBase } from "@/utils/path";

interface Props {
  speakers?: Speaker[];
}

const { speakers = defaultSpeakers } = Astro.props;

const hasSpeakers = speakers.length > 0;

const getSpeakerSlug = (speaker: Speaker) =>
  speaker.name.toLowerCase().replace(/\s+/g, "-");
---

<Section
  class="bg-page !pt-size-13 !pb-size-15"
  ariaLabelledby="speaker-list-heading"
>
  <Container class="mx-auto max-w-[1200px]">
    <div class="mx-auto w-full max-w-[480px] lg:max-w-none">
      <header
        class="flex flex-col items-start gap-size-3 pb-size-7 text-left lg:items-start lg:text-left"
      >
        <p
          class="w-full font-['Plus_Jakarta_Sans'] text-[15px] font-medium uppercase leading-none tracking-normal text-[#F37D16] lg:hidden"
        >
          NUESTROS PONENTES
        </p>

        <h2
          id="speaker-list-heading"
          class="type-h2 text-heading max-w-[750px] mb-size-8 md:mb-size-10 font-display font-semibold text-[32px] leading-[1.1] md:text-[64px]"
        >
          Las personas que están transformando el sector:
        </h2>
      </header>

      {
        hasSpeakers ? (
          <ul class="flex w-full list-none flex-col p-0">
            {speakers.map((speaker) => (
              <li
                id={`speaker-${speaker.id}`}
                class="w-full border-b border-stroke-strong"
              >
                <a
                  href={withBase(`/speakers/${getSpeakerSlug(speaker)}`)}
                  class="flex w-full items-center gap-size-6 py-size-6
                    text-left lg:gap-size-7 lg:py-size-8"
                  aria-label={`Ver perfil de ${speaker.name} ${speaker.lastName}`}
                >
                  <div
                    class="flex h-[100px] w-[100px] flex-none lg:h-[144px]
                      lg:w-[144px]"
                  >
                    <img
                      src={withBase(speaker.image)}
                      alt={`Retrato de ${speaker.name} ${speaker.lastName}`}
                      width="100"
                      height="100"
                      class="h-full w-full object-cover"
                      loading="lazy"
                    />
                  </div>

                  <div class="flex min-w-0 flex-1 flex-col justify-center gap-size-2">
                    <h3
                      class="min-w-0 flex-1 truncate font-display font-medium
                        text-[18px] leading-[1.2] text-heading lg:text-[24px]"
                    >
                      {speaker.name} {speaker.lastName}
                    </h3>

                    <div class="flex min-w-0 items-end justify-between">
                      <p
                        class="min-w-0 flex-1 truncate font-body text-[14px]
                          leading-[1.4] text-body lg:text-[16px]"
                        title={`${speaker.role} · ${speaker.Empresa}`}
                      >
                        {speaker.role} · {speaker.Empresa}
                      </p>

                      <span
                        class="relative size-6 shrink-0 text-highlighted"
                        aria-hidden="true"
                      >
                        <svg
                          width="15"
                          height="18"
                          viewBox="0 0 15 18"
                          fill="none"
                          class="size-6"
                        >
                          <path
                            d="M7.5 1V16.5M1.5 10.5L7.5 16.5L13.5 10.5"
                            stroke="currentColor"
                            stroke-width="1.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="pt-size-6 font-body text-[16px] text-[#D5CABF]">
            No hay ponentes disponibles.
          </p>
        )
      }

      <div
        class="mx-auto flex w-full max-w-[343px] flex-col
          items-center pt-size-13 lg:max-w-[320px]"
      >
        <CtaNote
          href={withBase("/entradas")}
          label="Consigue tu entrada"
          footnote="Plazas disponibles · Aforo limitado"
          noteAlign="center"
          block={true}
        />
      </div>
    </div>
  </Container>
</Section>
