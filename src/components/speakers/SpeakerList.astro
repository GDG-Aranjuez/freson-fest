---
import CtaNote from "@/components/shared/CtaNote.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { hero as agendaHero } from "@/data/agenda";
import { speakers as defaultSpeakers, speakersHero } from "@/data/speakers";
import type { Speaker } from "@/types/speakers";
import { withBase } from "@/utils/path";

interface Props {
  speakers?: Speaker[];
}

const { speakers = defaultSpeakers } = Astro.props;

const hasSpeakers = speakers.length > 0;

const getSpeakerSlug = (speaker: Speaker) =>
  speaker.name.toLowerCase().replace(/\s+/g, "-");
---

<Section
  class="bg-page !pt-size-9 !pb-size-15"
  ariaLabelledby="speaker-list-heading"
>
  <Container>
    <div class="mx-auto w-full max-w-[480px] lg:max-w-[1040px]">
      <h2
        id="speaker-list-heading"
        class="w-full pb-size-4 font-['Plus_Jakarta_Sans']
          text-[15px] font-light uppercase leading-none
          tracking-wider text-[#F37D16]"
      >
        {speakersHero.listEyebrow}
      </h2>

      {
        hasSpeakers ? (
          <ul class="flex w-full list-none flex-col gap-[2px] p-0 pt-size-6 lg:pt-size-7 lg:pb-size-10">
            {speakers.map((speaker) => (
              <li
                id={`speaker-${speaker.id}`}
                class="h-[124px] w-full border-b border-[#272421] lg:h-[168px]"
              >
                <a
                  href={withBase(`/speakers/${getSpeakerSlug(speaker)}`)}
                  class="flex h-full w-full pr-[4px] pb-[2px]"
                  aria-label={`Ver perfil de ${speaker.name} ${speaker.lastName}`}
                >
                  <div class="flex h-[110px] w-[100px] flex-none pt-[8px] pb-[2px] lg:h-[154px] lg:w-[144px]">
                    <img
                      src={withBase(speaker.image)}
                      alt={`Retrato de ${speaker.name} ${speaker.lastName}`}
                      width="100"
                      height="100"
                      class="h-[100px] w-[100px] object-cover lg:h-[144px] lg:w-[144px]"
                      loading="lazy"
                    />
                  </div>

                  <div
                    class="mt-[8px] flex h-[104px] min-w-0 flex-1
                      flex-col justify-start gap-[4px] pr-[16px] pl-[12px] lg:h-[144px] lg:gap-[6px]"
                  >
                    <h3
                      class="w-full truncate font-['Bricolage_Grotesque']
                        text-[20px] font-medium leading-[110%]
                        tracking-normal text-[#FEFAF5]"
                    >
                      {speaker.name} {speaker.lastName}
                    </h3>

                    <div class="flex min-w-0 items-end justify-between">
                      <p
                        class="min-w-0 flex-1 truncate
                          font-['Plus_Jakarta_Sans'] text-[14px]
                          font-medium leading-[120%] tracking-normal
                          text-[#D5CABF]"
                        title={`${speaker.role} · ${speaker.Empresa}`}
                      >
                        {speaker.role} · {speaker.Empresa}
                      </p>

                      <span
                        class="flex h-[48px] w-[48px] flex-none
                          items-center justify-center py-[8px]
                          text-[#F49E52]"
                        aria-hidden="true"
                      >
                        <svg
                          width="15"
                          height="18"
                          viewBox="0 0 15 18"
                          fill="none"
                          class="h-[17.62px] w-[14.6px]"
                        >
                          <path
                            d="M7.5 1V16.5M1.5 10.5L7.5 16.5L13.5 10.5"
                            stroke="currentColor"
                            stroke-width="1.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="pt-size-6 font-body text-[16px] text-[#D5CABF]">
            No hay ponentes disponibles.
          </p>
        )
      }

      <div class="w-full pt-size-12 lg:pt-size-9">
        <CtaNote
          href={agendaHero.cta.href}
          label="Consigue tu entrada"
          footnote="Plazas disponibles · Aforo limitado"
          noteAlign="center"
          variant="agenda"
          class="lg:mx-auto lg:w-[280px]"
        />
      </div>
    </div>
  </Container>
</Section>
