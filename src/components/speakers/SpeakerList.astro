---
import CtaNote from "@/components/shared/CtaNote.astro";
import SpeakerCard from "@/components/speakers/SpeakerCard.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { speakers as defaultSpeakers, speakersHero } from "@/data/speakers";
import { ticketsCta } from "@/data/tickets";
import type { Speaker } from "@/types/speakers";

interface Props {
  speakers?: Speaker[];
}

const { speakers = defaultSpeakers } = Astro.props;

const hasSpeakers = speakers.length > 0;
---

<Section class="!pt-size-13 !pb-size-15" ariaLabelledby="speaker-list-heading">
  <Container class="mx-auto max-w-[1200px]">
    <div class="mx-auto w-full max-w-[480px] lg:max-w-none">
      <header class="pb-size-7 text-left">
        <h2
          id="speaker-list-heading"
          class="type-h2 text-heading max-w-[750px] font-display
            font-semibold text-[32px] leading-[1.1]"
        >
          <span aria-hidden="true" class="lg:hidden">
            Están transformando el sector:
          </span>
          <span class="sr-only">
            Las personas que están transformando el sector:
          </span>
        </h2>

        <p
          class="hidden pt-size-8 font-['Plus_Jakarta_Sans'] text-[18px]
            font-medium uppercase leading-none tracking-normal
            text-[#F37D16] lg:block"
        >
          {speakersHero.nuestrosPonentes}
        </p>
      </header>

      {
        hasSpeakers ? (
          <ul class="flex w-full list-none flex-col p-0">
            {speakers.map((speaker) => (
              <SpeakerCard speaker={speaker} />
            ))}
          </ul>
        ) : (
          <p class="pt-size-6 font-body text-[16px] text-[#D5CABF]">
            No hay ponentes disponibles.
          </p>
        )
      }

      <div
        class="mx-auto flex w-full max-w-[343px] flex-col
          items-center pt-size-13 lg:max-w-[320px]"
      >
        <CtaNote
          href={ticketsCta.href}
          label={ticketsCta.label}
          footnote="Plazas disponibles · Aforo limitado"
          noteAlign="center"
          block={true}
        />
      </div>
    </div>
  </Container>
</Section>

<script>
  function setSpeakerExpanded(trigger: HTMLButtonElement, expanded: boolean) {
    trigger.setAttribute("aria-expanded", String(expanded));
    const card = trigger.closest("[data-speaker-card]");
    if (card instanceof HTMLElement) {
      card.dataset.expanded = String(expanded);
    }

    const speakerName = trigger.dataset.speakerName || "";
    if (expanded) {
      trigger.setAttribute(
        "aria-label",
        speakerName
          ? `Ocultar información de ${speakerName}`
          : "Ocultar información"
      );
    } else {
      trigger.setAttribute(
        "aria-label",
        speakerName
          ? `Mostrar información de ${speakerName}`
          : "Mostrar información"
      );
    }

    const panelId = trigger.getAttribute("aria-controls");
    const panel = panelId ? document.getElementById(panelId) : null;
    if (!(panel instanceof HTMLElement)) return;

    if (expanded) {
      panel.removeAttribute("inert");
    } else {
      panel.setAttribute("inert", "");
    }
  }

  function initSpeakerCards() {
    document.querySelectorAll("[data-speaker-toggle]").forEach((node) => {
      if (!(node instanceof HTMLButtonElement)) return;
      if (node.dataset.bound === "true") return;
      node.dataset.bound = "true";

      node.addEventListener("click", () => {
        const isExpanded = node.getAttribute("aria-expanded") === "true";
        setSpeakerExpanded(node, !isExpanded);
      });
    });
  }

  initSpeakerCards();
  document.addEventListener("astro:page-load", initSpeakerCards);
</script>
