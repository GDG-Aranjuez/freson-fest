---
import CtaNote from "@/components/shared/CtaNote.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { hero as agendaHero } from "@/data/agenda";
import { speakersHero } from "@/data/speakers";
---

<Section
  class="!py-size-13 lg:!pt-size-13 lg:!pb-size-15"
  ariaLabelledby="speakers-hero-heading"
>
  <Container>
    <div
      class="mx-auto flex w-full max-w-[480px] flex-col lg:max-w-none
        lg:flex-row lg:items-start lg:gap-size-9"
    >
      <p
        class="w-full pb-size-6 font-['Plus_Jakarta_Sans']
          text-[15px] font-medium uppercase leading-none
          tracking-normal text-[#F37D16] lg:hidden"
      >
        {speakersHero.eyebrow}
      </p>

      <h1
        id="speakers-hero-heading"
        class="w-full max-w-[541px] pb-size-7
          font-['Bricolage_Grotesque'] text-[56px]
          font-extrabold leading-none tracking-normal text-heading
          lg:w-[700px] lg:max-w-[700px] lg:shrink-0 lg:type-h1"
      >
        <span class="block">{speakersHero.title}</span>
        <span class="block text-[#F37D16]">
          {speakersHero.highlightedTitle}
        </span>
      </h1>

      <div
        class="flex w-full flex-col gap-size-9 lg:w-[280px] lg:max-w-[560px]"
      >
        <p
          class="w-full font-['Plus_Jakarta_Sans']
            text-[16px] font-normal leading-[140%]
            tracking-normal text-[#A09A90] lg:w-[280px] lg:text-[20px]
            lg:leading-[120%] lg:text-[#D5CABF]"
        >
          {speakersHero.subtitle}
        </p>

        <CtaNote
          href={agendaHero.cta.href}
          label={agendaHero.cta.label}
          footnote={agendaHero.cta.footnote}
          variant="agenda"
          class="lg:w-[280px]"
        />
      </div>
    </div>
  </Container>
</Section>
