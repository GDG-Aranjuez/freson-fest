---
import { BackgroundRippleEffect } from "@/components/ui/BackgroundRippleEffect";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { speakersHero } from "@/data/speakers";
---

<Section
  class="relative bg-page overflow-hidden !py-size-9 lg:!pt-size-13 lg:!pb-size-15"
  ariaLabelledby="speakers-hero-heading"
>
  <div
    class="absolute inset-0 z-0 pointer-events-auto flex items-center justify-center"
  >
    <div class="relative w-full max-w-[1200px] h-full mx-auto px-0 sm:px-4">
      <BackgroundRippleEffect client:idle />
      <div
        class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-page pointer-events-none"
      ></div>
    </div>
  </div>

  <Container
    class="relative z-10 w-full max-w-[1200px] mx-auto pointer-events-none"
  >
    <div
      class="mx-auto flex w-full max-w-[480px] flex-col
        items-center text-center lg:max-w-none"
    >
      <p
        class="w-full pb-size-6 text-center font-['Plus_Jakarta_Sans']
          text-[15px] font-medium uppercase leading-none
          tracking-normal text-[#F37D16] lg:hidden"
      >
        {speakersHero.eyebrow}
      </p>

      <h1
        id="speakers-hero-heading"
        class="mx-auto w-full max-w-[541px] pb-size-6
          font-display font-extrabold text-[48px] leading-[1.05]
          text-center text-heading lg:max-w-none
          lg:pb-size-9 lg:text-[96px]"
      >
        <span class="lg:hidden">
          <span class="block">{speakersHero.title}</span>
          <span class="block text-highlighted">
            {speakersHero.highlightedTitle}
          </span>
        </span>

        <span class="hidden lg:block">{speakersHero.desktopTitle}</span>
      </h1>

      <p
        class="w-full pb-size-2 pt-size-11 text-center
          font-['Plus_Jakarta_Sans'] text-[15px] font-medium
          uppercase leading-none tracking-normal
          text-[#F37D16] lg:hidden"
      >
        {speakersHero.nuestrosPonentes}
      </p>
    </div>
  </Container>
</Section>
