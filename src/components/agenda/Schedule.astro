---
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { agenda } from "@/data/agenda";
---

<Section
  class="!pt-size-9 !pb-0 lg:!pt-size-10"
  ariaLabelledby="agenda-schedule-heading"
>
  <Container>
    <div class="mx-auto w-full lg:max-w-[1040px]">
      <h2
        id="agenda-schedule-heading"
        class="max-w-[319px] pb-size-7 font-['Bricolage_Grotesque'] text-[24px] font-bold leading-[1.1] tracking-normal text-heading lg:max-w-none lg:pb-size-6 lg:text-[40px]"
      >
        {agenda.headline}
      </h2>

      <div class="flex flex-col">
        {
          agenda.days.flatMap((day) =>
            day.sessions.map((session) =>
              session.expandable && session.description ? (
                <details class="group/session border-b border-stroke-strong">
                  <summary class="grid cursor-pointer list-none grid-cols-[48px_minmax(0,1fr)_24px] gap-size-3 py-size-6 lg:py-size-11 [&::-webkit-details-marker]:hidden">
                    <time
                      datetime={session.startTime}
                      class="pt-[2px] font-['Plus_Jakarta_Sans'] text-[12px] font-medium leading-none text-[#F37D16]"
                    >
                      {session.startTime}
                    </time>

                    <div class="min-w-0">
                      <h3 class="font-['Bricolage_Grotesque'] text-[16px] font-semibold leading-[1.1] text-heading">
                        {session.title}
                      </h3>

                      {session.speaker && (
                        <p class="pt-size-2 text-[13px] leading-[1.2] text-body">
                          {session.speaker}
                        </p>
                      )}

                      {session.location && (
                        <p class="pt-size-1 text-[11px] leading-[1.2] text-muted">
                          {session.location}
                        </p>
                      )}

                      {session.type === "Taller" && (
                        <span class="mt-size-3 inline-flex bg-[#F37D16] px-size-2 py-size-1 text-[10px] font-medium leading-none text-[#272421]">
                          Taller
                        </span>
                      )}
                    </div>

                    <span
                      class="relative mt-auto size-6 text-[#F37D16]"
                      aria-hidden="true"
                    >
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        class="absolute inset-0 size-6 group-open/session:opacity-0"
                      >
                        <path
                          d="M12 5v14M5 12h14"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                        />
                      </svg>

                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        class="absolute inset-0 size-6 opacity-0 group-open/session:opacity-100"
                      >
                        <path
                          d="M5 12h14"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                        />
                      </svg>
                    </span>
                  </summary>

                  {session.description && (
                    <div class="pb-size-6 pl-[60px] pr-size-7">
                      <p class="type-paragraph-m text-body">
                        {session.description}
                      </p>
                    </div>
                  )}
                </details>
              ) : (
                <div class="grid grid-cols-[48px_minmax(0,1fr)] gap-size-3 border-b border-stroke-strong py-size-6 lg:py-size-11">
                  <time
                    datetime={session.startTime}
                    class="pt-[2px] font-['Plus_Jakarta_Sans'] text-[12px] font-medium leading-none text-[#F37D16]"
                  >
                    {session.startTime}
                  </time>

                  <div class="min-w-0">
                    <h3 class="font-['Bricolage_Grotesque'] text-[16px] font-semibold leading-[1.1] text-heading">
                      {session.title}
                    </h3>

                    {session.speaker && (
                      <p class="pt-size-2 text-[13px] leading-[1.2] text-body">
                        {session.speaker}
                      </p>
                    )}

                    {session.location && (
                      <p class="pt-size-1 text-[11px] leading-[1.2] text-muted">
                        {session.location}
                      </p>
                    )}
                  </div>
                </div>
              )
            )
          )
        }
      </div>
    </div>
  </Container>
</Section>
