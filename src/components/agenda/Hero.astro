---
import CtaNote from "@/components/shared/CtaNote.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { agenda, hero } from "@/data/agenda";
---

<Section
  class="!py-size-13 lg:!pt-size-13 lg:!pb-size-15"
  ariaLabelledby="agenda-hero-heading"
>
  <Container>
    <div class="flex w-full flex-col lg:max-w-[700px]">
      <!-- Visible only on mobile -->
      <p
        class="pb-size-6 font-['Plus_Jakarta_Sans'] text-[15px] font-medium uppercase leading-none tracking-normal text-[#F37D16] lg:hidden"
      >
        {agenda.eyebrow}
      </p>

      <h1
        id="agenda-hero-heading"
        aria-label={hero.title}
        class="w-full max-w-[343px] pb-size-7 font-['Bricolage_Grotesque'] text-[56px] font-extrabold leading-[100%] tracking-normal text-heading lg:max-w-[700px] lg:pb-size-9 lg:type-h1"
      >
        <span aria-hidden="true">
          <span class="block">
            <span class="block lg:inline">Una</span>
            {" "}
            <span class="block lg:inline">experiencia</span>
          </span>

          <span class="block">que no te</span>

          <span class="block">
            <span class="block lg:inline">puedes</span>
            {" "}
            <span class="block lg:inline">perder</span>
          </span>
        </span>
      </h1>

      <!-- Visible only on mobile -->
      <p
        class="type-subtitle max-w-[343px] pb-size-9 font-normal text-subtitle lg:hidden"
      >
        {hero.subtitle}
      </p>

      <CtaNote
        href={hero.cta.href}
        label={hero.cta.label}
        footnote={hero.cta.footnote}
        noteAlign="center"
        variant="agenda"
      />
    </div>
  </Container>
</Section>
