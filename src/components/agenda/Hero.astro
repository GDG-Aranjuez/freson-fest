---
import { BackgroundRippleEffect } from "@/components/ui/BackgroundRippleEffect.tsx";
import CtaNote from "@/components/shared/CtaNote.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { hero } from "@/data/agenda";
---

<Section
  class="relative overflow-hidden !py-size-13 lg:!pt-size-13 lg:!pb-size-13"
  ariaLabelledby="agenda-hero-heading"
>
  {/* Fondo interactivo con ondas Ripple */}
  <div
    class="absolute inset-0 z-0 pointer-events-auto flex items-center justify-center"
  >
    <div class="relative w-full max-w-[1200px] h-full mx-auto px-0 sm:px-4">
      <BackgroundRippleEffect client:idle />
      <div
        class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-page pointer-events-none"
      ></div>
    </div>
  </div>

  <Container
    class="relative z-10 w-full max-w-[1200px] mx-auto pointer-events-none"
  >
    <div class="flex w-full flex-col items-center text-center">
      <h1
        id="agenda-hero-heading"
        class="w-full max-w-[700px] pb-size-6 font-display text-[48px] sm:text-[64px] lg:text-[96px] font-extrabold leading-[0.9] text-center text-heading lg:pb-size-10 pointer-events-auto"
      >
        <span class="block">El próximo</span>
        <span class="block text-brand">26 de octubre</span>
      </h1>

      <div
        class="flex w-full sm:max-w-[320px] flex-col items-start pointer-events-auto"
      >
        <CtaNote
          href={hero.cta.href}
          label={hero.cta.label}
          footnote={hero.cta.footnote}
          noteAlign="center"
          block={true}
        />
      </div>
    </div>
  </Container>
</Section>
