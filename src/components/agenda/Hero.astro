---
import CtaNote from "@/components/shared/CtaNote.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { hero } from "@/data/agenda";
---

<Section
  class="!py-size-13 lg:!pt-size-13 lg:!pb-size-15"
  ariaLabelledby="agenda-hero-heading"
>
  <Container>
    <div
      class="flex flex-col lg:flex-row lg:items-end lg:justify-between lg:gap-size-9"
    >
      <div class="flex min-w-0 flex-1 flex-col lg:max-w-[700px]">
        <p class="type-eyebrow pb-size-6 text-subtitle">
          <span class="font-light">{hero.dateLead}</span>
          {" "}
          <span class="font-medium">{hero.dateYear}</span>
        </p>

        <h1 id="agenda-hero-heading" class="type-h1 pb-size-7">
          {hero.title}
        </h1>
      </div>

      <div class="flex w-full flex-col lg:w-[280px] lg:shrink-0 lg:gap-size-9">
        <p class="type-subtitle pb-size-12 font-normal text-subtitle lg:pb-0">
          {hero.subtitle}
        </p>

        <CtaNote
          href={hero.cta.href}
          label={hero.cta.label}
          footnote={hero.cta.footnote}
          noteAlign="start"
        />
      </div>
    </div>
  </Container>
</Section>
