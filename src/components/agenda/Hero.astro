---
import CtaNote from "@/components/shared/CtaNote.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { agenda, hero } from "@/data/agenda";
---

<Section
  class="!py-size-13 lg:!pt-size-13 lg:!pb-size-13"
  ariaLabelledby="agenda-hero-heading"
>
  <Container>
    <div class="flex w-full flex-col items-center text-center">
      <p
        class="w-full pb-size-6 font-['Plus_Jakarta_Sans'] text-[15px]
          font-medium uppercase leading-none tracking-normal text-[#F37D16]
          lg:hidden"
      >
        {agenda.eyebrow}
      </p>

      <h1
        id="agenda-hero-heading"
        class="w-full max-w-[700px] pb-size-6 font-['Bricolage_Grotesque']
          text-[40px] font-extrabold leading-[100%] tracking-normal
          text-heading lg:pb-size-10 lg:type-h1"
      >
        <span class="block lg:inline">No te puedes perder</span>
        <span class="mt-size-2 block lg:ml-size-2 lg:mt-0 lg:inline"
          >esta experiencia.</span
        >
      </h1>

      <CtaNote
        href={hero.cta.href}
        label={hero.cta.label}
        footnote={hero.cta.footnote}
        noteAlign="center"
        variant="agenda"
        class="w-full max-w-[343px] lg:max-w-[347px]"
        noteClass="!font-body !text-[16px] !leading-[1.4] !text-body/80"
      />
    </div>
  </Container>
</Section>
