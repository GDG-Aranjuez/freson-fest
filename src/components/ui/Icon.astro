---
import { icons, type IconName } from "@/types/icon";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = "" } = Astro.props;
const icon = icons[name];
---

<svg
  width={size}
  height={size}
  viewBox={icon.viewBox}
  fill="currentColor"
  class={className}
  aria-hidden="true"
>
  {icon.paths.map(({ d, opacity }) => <path d={d} opacity={opacity} />)}
</svg>
