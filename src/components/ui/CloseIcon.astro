---
interface Props {
  id?: string;
  class?: string;
}

const { id, class: className = "" } = Astro.props;
---

<svg
  id={id}
  width="36"
  height="36"
  viewBox="0 0 36 36"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  class={className}
  aria-hidden="true"
>
  <path d="M9 9l18 18M27 9L9 27"></path>
</svg>
