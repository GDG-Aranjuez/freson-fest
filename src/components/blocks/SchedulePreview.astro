---
import GhostLink from "@/components/blocks/GhostLink.astro";
import ScheduleSessionRow from "@/components/blocks/ScheduleSessionRow.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import type { AgendaSession } from "@/data/agenda";

interface Props {
  sessions: AgendaSession[];
  eyebrow: string;
  heading: string;
  cta: { href: string; label: string };
}

const { sessions, eyebrow, heading, cta } = Astro.props;

const talks = sessions.filter(
  (session) => session.type === "Charla" || session.type === "Panel"
);

const workshops = sessions.filter((session) => session.type === "Taller");
---

<Section
  class="!py-size-13 lg:!py-size-15"
  ariaLabelledby="home-agenda-heading"
>
  <Container>
    <div class="mx-auto w-full max-w-[1040px]" data-schedule-preview>
      <header class="pb-size-8 lg:pb-size-10">
        <p class="inline-flex items-center pb-size-3 font-body text-[15px] font-light uppercase tracking-normal text-brand md:text-[18px] md:font-medium">
          {eyebrow}
        </p>
        <h2
          id="home-agenda-heading"
          class="font-display text-[40px] font-semibold leading-[1.1] text-heading md:text-[64px]"
        >
          {heading}
        </h2>
      </header>

      <div class="relative w-full">
        {/* Pestañas (Tabs) */}
        <div class="flex gap-1 md:gap-1" role="tablist">
          <button
            id="tab-charlas"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="panel-charlas"
            data-tab-btn="charlas"
            class="tab-trapezoid relative z-10 flex h-[56px] w-[256px] cursor-pointer items-center justify-center bg-surface font-display text-[18px] font-medium leading-[1.1] text-heading transition-colors lg:text-[20px]"
          >
            Charlas
          </button>
          <button
            id="tab-workshops"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-workshops"
            data-tab-btn="workshops"
            class="tab-trapezoid relative z-0 flex h-[56px] w-[256px] cursor-pointer items-center justify-center bg-[#171512] font-display text-[18px] font-medium leading-[1.1] text-subtitle transition-colors hover:text-heading lg:text-[20px]"
          >
            Workshops
          </button>
        </div>

        {/* Contenedor principal de 1040px */}
        <div class="relative z-10 border border-stroke-strong/30 bg-surface">
          {/* Panel Charlas */}
          <div
            id="panel-charlas"
            role="tabpanel"
            aria-labelledby="tab-charlas"
            data-tab-panel="charlas"
            class="p-0"
          >
            <div class="flex flex-col">
              {talks.map((session) => (
                <ScheduleSessionRow session={session} />
              ))}
            </div>
          </div>

          {/* Panel Workshops */}
          <div
            id="panel-workshops"
            role="tabpanel"
            aria-labelledby="tab-workshops"
            data-tab-panel="workshops"
            class="hidden p-0"
          >
            <div class="flex flex-col">
              {workshops.map((session) => (
                <ScheduleSessionRow session={session} />
              ))}
            </div>
          </div>

          <div class="flex justify-end border-t border-stroke-strong/20 bg-surface px-6 py-4">
            <GhostLink href={cta.href} label={cta.label} />
          </div>
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  .tab-trapezoid {
    clip-path: polygon(14px 0, calc(100% - 14px) 0, 100% 100%, 0 100%);
  }
</style>

<script>
  function initializeAgendaTabs() {
    document.querySelectorAll("[data-schedule-preview]").forEach((root) => {
      const tabBtns =
        root.querySelectorAll<HTMLButtonElement>("[data-tab-btn]");
      const tabPanels = root.querySelectorAll<HTMLElement>("[data-tab-panel]");

      tabBtns.forEach((btn) => {
        if (btn.dataset.bound === "true") return;
        btn.dataset.bound = "true";

        btn.addEventListener("click", () => {
          const target = btn.dataset.tabBtn;

          tabBtns.forEach((b) => {
            const isSelected = b === btn;
            b.setAttribute("aria-selected", String(isSelected));

            if (isSelected) {
              b.classList.remove("bg-[#171512]", "text-subtitle", "z-0");
              b.classList.add("bg-surface", "text-heading", "z-10");
            } else {
              b.classList.remove("bg-surface", "text-heading", "z-10");
              b.classList.add("bg-[#171512]", "text-subtitle", "z-0");
            }
          });

          tabPanels.forEach((panel) => {
            if (panel.dataset.tabPanel === target) {
              panel.classList.remove("hidden");
            } else {
              panel.classList.add("hidden");
            }
          });
        });
      });
    });
  }

  initializeAgendaTabs();
  document.addEventListener("astro:page-load", initializeAgendaTabs);
</script>
