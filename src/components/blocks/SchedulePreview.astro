---
import GhostLink from "@/components/blocks/GhostLink.astro";
import ScheduleSessionRow from "@/components/blocks/ScheduleSessionRow.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import type { AgendaSessionView } from "@/data/agenda";

interface Props {
  sessions: AgendaSessionView[];
  eyebrow: string;
  heading: string;
  cta: { href: string; label: string };
}

const { sessions, eyebrow, heading, cta } = Astro.props;

const talks = sessions.filter(
  (session) => session.track === "auditorium" || session.track === "shared"
);

const workshops = sessions
  .filter(
    (session) => session.track === "workshop" || session.track === "shared"
  )
  .sort((a, b) => a.startTime.localeCompare(b.startTime))
  .map((session) =>
    session.track === "shared"
      ? { ...session, id: `workshops-${session.id}` }
      : session
  );
---

<Section
  class="!py-size-13 lg:!py-size-15"
  ariaLabelledby="home-agenda-heading"
>
  <Container>
    <div class="mx-auto w-full max-w-[1040px]" data-schedule-preview>
      <header class="pb-size-8 lg:pb-size-10">
        <p class="inline-flex items-center pb-size-3 font-body text-[15px] font-light uppercase tracking-normal text-brand md:text-[18px] md:font-medium">
          {eyebrow}
        </p>
        <h2
          id="home-agenda-heading"
          class="font-display text-[40px] font-semibold leading-[1.1] text-heading md:text-[64px]"
        >
          {heading}
        </h2>
      </header>

      <div class="relative w-full">
        <div class="flex items-center" role="tablist">
          <button
            id="tab-charlas"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="panel-charlas"
            data-tab-btn="charlas"
            class="schedule-tab relative flex h-12 min-w-0 flex-1 cursor-pointer items-center justify-center rounded-t-2xl font-display text-[16px] font-medium leading-[1.1] transition-all md:h-14 md:w-[256px] md:flex-none md:rounded-t-lg md:text-[18px] lg:text-[20px]"
          >
            Charlas
          </button>
          <button
            id="tab-workshops"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-workshops"
            data-tab-btn="workshops"
            class="schedule-tab relative -ml-5 flex h-12 min-w-0 flex-1 cursor-pointer items-center justify-center rounded-t-2xl font-display text-[16px] font-medium leading-[1.1] transition-all md:-ml-6 md:h-14 md:w-[256px] md:flex-none md:rounded-t-lg md:text-[18px] lg:text-[20px]"
          >
            Workshops
          </button>
        </div>
        {/* Contenedor principal de 1040px */}
        <div class="relative z-10 border border-stroke bg-surface">
          {/* Panel Charlas */}
          <div
            id="panel-charlas"
            role="tabpanel"
            aria-labelledby="tab-charlas"
            data-tab-panel="charlas"
            class="p-0"
          >
            <div class="flex flex-col">
              {talks.map((session) => (
                <ScheduleSessionRow session={session} />
              ))}
            </div>
          </div>

          {/* Panel Workshops */}
          <div
            id="panel-workshops"
            role="tabpanel"
            aria-labelledby="tab-workshops"
            data-tab-panel="workshops"
            class="hidden p-0"
          >
            <div class="flex flex-col">
              {workshops.map((session) => (
                <ScheduleSessionRow session={session} />
              ))}
            </div>
          </div>

          <div class="flex justify-center border-t border-stroke bg-surface px-4 py-5 md:justify-end md:px-6">
            <GhostLink href={cta.href} label={cta.label} />
          </div>
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  .schedule-tab[aria-selected="true"] {
    z-index: 20;
    background-color: var(--color-surface-raised);
    color: var(--color-heading);
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.1),
      0 2px 4px -2px rgb(0 0 0 / 0.1);
  }

  .schedule-tab[aria-selected="false"] {
    z-index: 10;
    background-color: var(--color-surface);
    color: color-mix(in srgb, var(--color-subtitle) 60%, transparent);
  }

  .schedule-tab[aria-selected="false"]:hover {
    color: var(--color-subtitle);
  }
</style>

<script>
  function initializeAgendaTabs() {
    document.querySelectorAll("[data-schedule-preview]").forEach((root) => {
      const tabBtns =
        root.querySelectorAll<HTMLButtonElement>("[data-tab-btn]");
      const tabPanels = root.querySelectorAll<HTMLElement>("[data-tab-panel]");

      tabBtns.forEach((btn) => {
        if (btn.dataset.bound === "true") return;
        btn.dataset.bound = "true";

        btn.addEventListener("click", () => {
          const target = btn.dataset.tabBtn;

          tabBtns.forEach((b) => {
            b.setAttribute("aria-selected", String(b === btn));
          });

          tabPanels.forEach((panel) => {
            if (panel.dataset.tabPanel === target) {
              panel.classList.remove("hidden");
            } else {
              panel.classList.add("hidden");
            }
          });
        });
      });
    });
  }

  function showAgendaTab(root: Element, tabName: string) {
    root
      .querySelectorAll<HTMLButtonElement>("[data-tab-btn]")
      .forEach((btn) => {
        btn.setAttribute(
          "aria-selected",
          String(btn.dataset.tabBtn === tabName)
        );
      });
    root.querySelectorAll<HTMLElement>("[data-tab-panel]").forEach((panel) => {
      panel.classList.toggle("hidden", panel.dataset.tabPanel !== tabName);
    });
  }

  function revealSessionFromHash() {
    const id = decodeURIComponent(window.location.hash.replace(/^#/, ""));
    if (!id) return;

    const target = document.getElementById(id);
    if (!target) return;

    const panel = target.closest<HTMLElement>("[data-tab-panel]");
    const tabName = panel?.dataset.tabPanel;
    const root = target.closest("[data-schedule-preview]");
    if (panel?.classList.contains("hidden") && tabName && root) {
      showAgendaTab(root, tabName);
    }

    requestAnimationFrame(() => {
      target.scrollIntoView({ block: "center" });
    });
  }

  function bootAgenda() {
    initializeAgendaTabs();
    revealSessionFromHash();
  }

  bootAgenda();
  document.addEventListener("DOMContentLoaded", bootAgenda);
  window.addEventListener("load", revealSessionFromHash);
  window.addEventListener("hashchange", revealSessionFromHash);
  document.addEventListener("astro:page-load", bootAgenda);
</script>
