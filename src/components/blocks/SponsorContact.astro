---
import ContactFormScript from "@/components/blocks/ContactFormScript.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";

export interface SponsorContactContent {
  eyebrow: string;
  title: string;
  subtitle: string;
  emailLabel: string;
  email: string;
  form: {
    nameLabel: string;
    companyLabel: string;
    emailLabel: string;
    messageLabel: string;
    submitButton: string;
    requiredFootnote: string;
    subject: string;
    successMessage: string;
    formError: string;
    fieldError: string;
  };
}

interface Props {
  contact: SponsorContactContent;
}

const { contact } = Astro.props;
const formspreeId = "mzedygvj";
---

<Section class="!py-size-13 lg:py-size-12">
  <div id="contacto" class="scroll-mt-24 lg:scroll-mt-28">
    <Container class="max-w-[1200px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-size-10 lg:gap-size-16 items-start">
        <div>
          <span class="type-eyebrow-medium pb-size-4 uppercase text-highlighted block font-body text-[14px] lg:text-[18px] leading-[1.0] mb-2">
            {contact.eyebrow}
          </span>
          <h2 class="type-h2 text-heading font-display font-semibold text-[32px] lg:text-[40px] leading-[1.1] mb-4">
            {contact.title}
          </h2>
          <p class="type-body text-subtitle/70 font-body font-normal text-[16px] lg:text-[20px] leading-[1.4] lg:leading-[1.2] mb-6">
            {contact.subtitle}
          </p>
          <p class="type-body font-body font-medium text-[14px] lg:text-[16px] text-body/80 leading-[1.2]">
            {contact.emailLabel}{" "}
            <a
              href={`mailto:${contact.email}`}
              class="text-link hover:underline font-body font-medium text-[14px] lg:text-[16px] leading-[1.2]"
            >
              {contact.email}
            </a>
          </p>
        </div>

        <form
          class="flex flex-col gap-y-6 w-full lg:max-w-[504px]"
          data-contact-form
          data-formspree-id={formspreeId}
        >
          <input type="hidden" name="_subject" value={contact.form.subject} />
          <p
            class="type-label w-full text-heading"
            data-fs-success
            role="status"
          >
            {contact.form.successMessage}
          </p>

          <div>
            <label
              for="name"
              class="block text-[14px] text-subtitle/70 font-body font-normal leading-[1.2] mb-2"
            >
              {contact.form.nameLabel}
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              data-fs-field
              class="w-full bg-surface border border-white/10 rounded-none px-4 py-2.5 text-[14px] text-heading focus:outline-none focus:border-brand transition-colors"
            />
            <p
              class="type-label w-full pt-2 text-highlighted"
              data-fs-error="name"
            >
              {contact.form.fieldError}
            </p>
          </div>

          <div>
            <label
              for="company"
              class="block text-[14px] text-subtitle/70 font-body font-normal leading-[1.2] mb-2"
            >
              {contact.form.companyLabel}
            </label>
            <input
              type="text"
              id="company"
              name="company"
              data-fs-field
              class="w-full bg-surface border border-white/10 rounded-none px-4 py-2.5 text-[14px] text-heading focus:outline-none focus:border-brand transition-colors"
            />
            <p
              class="type-label w-full pt-2 text-highlighted"
              data-fs-error="company"
            >
              {contact.form.fieldError}
            </p>
          </div>

          <div>
            <label
              for="email"
              class="block text-[14px] text-subtitle/70 font-body font-normal leading-[1.2] mb-2"
            >
              {contact.form.emailLabel}
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              data-fs-field
              class="w-full bg-surface border border-white/10 rounded-none px-4 py-2.5 text-[14px] text-heading focus:outline-none focus:border-brand transition-colors"
            />
            <p
              class="type-label w-full pt-2 text-highlighted"
              data-fs-error="email"
            >
              {contact.form.fieldError}
            </p>
          </div>

          <div>
            <label
              for="message"
              class="block text-[14px] text-subtitle/70 font-body font-normal leading-[1.2] mb-2"
            >
              {contact.form.messageLabel}
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              data-fs-field
              class="w-full bg-surface border border-white/10 rounded-none px-4 py-2.5 text-[14px] text-heading focus:outline-none focus:border-brand transition-colors resize-y"
            ></textarea>
            <p
              class="type-label w-full pt-2 text-highlighted"
              data-fs-error="message"
            >
              {contact.form.fieldError}
            </p>
          </div>

          <div class="flex flex-col gap-y-4">
            <p class="font-body text-[14px] leading-[1.4] text-subtitle/80 font-normal">
              {contact.form.requiredFootnote}
            </p>
            <p
              class="type-label w-full text-highlighted"
              data-fs-error=""
              role="alert"
            >
              {contact.form.formError}
            </p>
            <Button type="submit" block={true} data-fs-submit-btn>
              {contact.form.submitButton}
            </Button>
          </div>
        </form>
      </div>
    </Container>
  </div>
</Section>

<ContactFormScript />
