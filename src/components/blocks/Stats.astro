---
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";

interface Props {
  stats: { value: string; label: string }[];
  class?: string;
}

const { stats, class: className = "" } = Astro.props;
---

<Section
  class:list={[
    "!pt-size-9 !pb-size-15 lg:!pt-size-13 lg:!pb-size-16",
    className,
  ]}
>
  <Container>
    <ul class="flex w-full list-none flex-col p-0 lg:flex-row">
      {stats.map((stat, index) => {
        const isLast = index === stats.length - 1;
        return (
          <li
            class:list={[
              "flex h-[180px] shrink-0 flex-col items-center justify-center gap-2 border-stroke px-size-6 py-size-7 text-center lg:h-auto lg:flex-1 lg:pb-size-9 lg:pt-size-7",
              "border-b",
              !isLast && "lg:border-b-0 lg:border-r-[1.5px]",
              isLast && "lg:border-b-0",
            ]}
          >
            <span class="font-display text-[40px] font-bold leading-[1.2] text-highlighted lg:text-[64px]">
              {stat.value}
            </span>
            <span class="font-display text-[20px] font-medium leading-[1.1] text-heading lg:text-[24px]">
              {stat.label}
            </span>
          </li>
        );
      })}
    </ul>
  </Container>
</Section>
