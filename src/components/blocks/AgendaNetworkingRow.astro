---
import type { AgendaSessionView } from "@/data/agenda";

interface Props {
  session: AgendaSessionView;
}

const { id, startTime, endTime, title } = Astro.props.session;

const lowerTitle = title.toLowerCase();
const isApertura =
  lowerTitle.includes("apertura") || lowerTitle.includes("registro");
const isCafe =
  lowerTitle.includes("café") ||
  lowerTitle.includes("cafe") ||
  lowerTitle.includes("churros");
const isPaella =
  lowerTitle.includes("paella") ||
  lowerTitle.includes("almuerzo") ||
  lowerTitle.includes("comida");
---

<div
  id={id}
  class="group relative flex w-full scroll-mt-28 items-center border-b border-stroke bg-surface px-4 py-4 text-[18px] transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:bg-surface-raised min-[833px]:border min-[833px]:px-6 min-[833px]:py-5 min-[833px]:text-[20px]"
>
  {/* Izquierda: Horas */}
  <div class="flex shrink-0 flex-col items-center pt-0.5 w-[60px] md:w-[70px] z-10">
    <time class="font-body text-[16px] md:text-[20px] font-regular text-center leading-none text-brand mt-2">
      {startTime}
    </time>
    <span class="mt-2 font-body text-[12px] md:text-[14px] font-regular text-center leading-none text-subtitle/50">
      {endTime}
    </span>
  </div>

  {/* Centro: Icono dinámico + Título */}
