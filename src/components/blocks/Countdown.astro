---
interface Props {
  targetDate: string;
  class?: string;
}

const { targetDate, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "hero-countdown flex items-end justify-center gap-size-6",
    className,
  ]}
  data-event-start={targetDate}
  aria-label="Cuenta atrás para el evento"
  role="timer"
>
  <p class="countdown-live" data-countdown-live>
    Ya ha empezado
  </p>
  <div class="countdown-clock" data-countdown-clock>
    <div class="flex flex-col items-center justify-center gap-size-1">
      <span class="countdown-num" data-countdown="days">
        --
      </span>
      <span class="countdown-label">días</span>
    </div>
    <span class="countdown-sep" aria-hidden="true">
      :
    </span>
    <div class="flex flex-col items-center justify-center gap-size-1">
      <span class="countdown-num" data-countdown="hours">
        --
      </span>
      <span class="countdown-label">horas</span>
    </div>
    <span class="countdown-sep" aria-hidden="true">
      :
    </span>
    <div class="flex flex-col items-center justify-center gap-size-1">
      <span class="countdown-num" data-countdown="minutes">
        --
      </span>
      <span class="countdown-label">minutos</span>
    </div>
    <span class="countdown-sep" aria-hidden="true">
      :
    </span>
    <div class="flex flex-col items-center justify-center gap-size-1">
      <span class="countdown-num" data-countdown="seconds">
        --
      </span>
      <span class="countdown-label">segundos</span>
    </div>
  </div>
</div>

<script>
  let countdownInterval: ReturnType<typeof setInterval> | undefined;

  function eventStartMs(root: Element): number | null {
    const raw = root.getAttribute("data-event-start");
    if (!raw) return null;
    const ms = new Date(raw).getTime();
    return Number.isNaN(ms) ? null : ms;
  }

  function markLive(root: Element) {
    root.classList.add("is-live");
    root.setAttribute("role", "status");
    root.setAttribute("aria-label", "Ya ha empezado");
  }

  function tick() {
    let running = false;

    document.querySelectorAll(".hero-countdown").forEach((root) => {
      if (root.classList.contains("is-live")) return;

      const start = eventStartMs(root);
      if (start === null) return;

      const diff = start - Date.now();
      if (diff <= 0) {
        markLive(root);
        return;
      }

      running = true;
      const days = Math.floor(diff / 86_400_000);
      const hours = Math.floor((diff % 86_400_000) / 3_600_000);
      const minutes = Math.floor((diff % 3_600_000) / 60_000);
      const seconds = Math.floor((diff % 60_000) / 1_000);

      const set = (key: string, val: number) => {
        const el = root.querySelector(`[data-countdown="${key}"]`);
        if (el) el.textContent = String(val);
      };
      set("days", days);
      set("hours", hours);
      set("minutes", minutes);
      set("seconds", seconds);
    });

    return running;
  }

  function initCountdown() {
    const running = tick();
    if (countdownInterval) clearInterval(countdownInterval);
    countdownInterval = running
      ? setInterval(() => {
          if (!tick() && countdownInterval) {
            clearInterval(countdownInterval);
            countdownInterval = undefined;
          }
        }, 1_000)
      : undefined;
  }

  initCountdown();
  document.addEventListener("astro:page-load", initCountdown);
</script>
