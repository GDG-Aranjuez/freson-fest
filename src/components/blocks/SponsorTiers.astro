---
import CtaNote from "@/components/blocks/CtaNote.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import TierIcon from "@/components/ui/TierIcon.astro";

export interface SponsorTierPlan {
  name: string;
  price: string;
  features: readonly string[];
}

export interface SponsorTiersContent {
  title: string;
  subtitle: string;
  plans: readonly SponsorTierPlan[];
}

interface Props {
  tiers: SponsorTiersContent;
}

const { tiers } = Astro.props;
---

<Section
  class="bg-page !pt-size-13 !pb-size-9 md:!py-size-12"
  data-sponsor-tiers
>
  <Container class="max-w-[1200px] mx-auto">
    <div class="mb-size-8 md:mb-size-10">
      <h2 class="type-h2 text-heading font-semibold font-display text-[32px] leading-[1.1] md:text-[64px] mb-4">
        {tiers.title}
      </h2>
      <p class="type-body text-subtitle/70 mt-2 font-body font-normal text-[14px] leading-[1.4] md:text-[20px] md:leading-[1.2]">
        {tiers.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-size-6">
      {tiers.plans.map((plan) => (
        <div class="glowing-card relative p-[2px] bg-white/10 transition-all duration-300">
          <div class="glow-overlay pointer-events-none absolute -inset-px opacity-0 transition-opacity duration-300 z-0" />

          <div class="relative bg-surface p-size-6 md:p-size-8 flex flex-col justify-between h-full z-10">
            <div>
              <div class="flex items-center justify-center gap-2 mb-size-6">
                <h3 class="type-h2 text-brand font-semibold font-display text-[28px] md:text-[40px] leading-[1.2] text-center">
                  {plan.name}
                </h3>
                <TierIcon name={plan.name} />
              </div>

              <ul class="space-y-3 mb-size-8">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-2 text-body/80 type-caption text-[14px] md:text-[16px] leading-[1.4]">
                    <span class="text-brand shrink-0 mt-0.5">✓</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div>
              <p class="type-h1 text-heading font-display font-semibold text-[32px] md:text-[40px] leading-[1.1] text-center mb-size-6">
                {plan.price}
              </p>
              <div>
                <CtaNote
                  href="#contacto"
                  label="Elegir patrocinio"
                  footnote=""
                  block={true}
                />
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </Container>
</Section>

<style>
  .glow-overlay {
    background: radial-gradient(
      600px circle at var(--mouse-x, 0px) var(--mouse-y, 0px),
      rgba(255, 115, 0, 0.85),
      transparent 50%
    );
  }

  .glowing-card:hover .glow-overlay {
    opacity: 1;
  }
</style>

<script>
  function initGlowingCards() {
    document.querySelectorAll("[data-sponsor-tiers]").forEach((root) => {
      root.querySelectorAll(".glowing-card").forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        if (card.dataset.bound === "true") return;
        card.dataset.bound = "true";

        card.addEventListener("mousemove", (e) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;

          card.style.setProperty("--mouse-x", `${x}px`);
          card.style.setProperty("--mouse-y", `${y}px`);
        });
      });
    });
  }

  initGlowingCards();
  document.addEventListener("astro:page-load", initGlowingCards);
</script>
