---
import type { Speaker } from "@/data/speakers";
import { withBase } from "@/utils/path";

interface Props {
  speaker: Speaker;
  fullName: string;
  headingId: string;
}

const { speaker, fullName, headingId } = Astro.props;
const company = speaker.company.replace(/^@/, "").trim();
const roleLine = [speaker.role, company && `@${company}`]
  .filter(Boolean)
  .join(" | ");
---

<div class="col-start-1 row-start-1 size-[100px] shrink-0 overflow-hidden lg:size-[144px]">
  <img
    src={withBase(speaker.image)}
    alt={`Retrato de ${fullName}`}
    width="144"
    height="144"
    class="size-full object-cover"
    loading="lazy"
  />
</div>

<div class="col-start-2 row-start-1 flex h-full min-w-0 flex-col justify-between self-stretch lg:h-auto lg:justify-start lg:gap-size-2 lg:self-start">
  <h3
    id={headingId}
    class="min-w-0 font-display font-medium text-[20px] leading-[1.15] text-heading lg:truncate lg:text-[24px] lg:leading-[1.2]"
  >
    {fullName}
  </h3>

  <p
    class="min-w-0 font-body text-[14px] leading-[1.4] text-body lg:truncate lg:text-[16px]"
    title={roleLine}
  >
    {roleLine}
  </p>
</div>
