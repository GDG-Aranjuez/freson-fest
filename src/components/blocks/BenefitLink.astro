---
import { withBase } from "@/utils/path";

interface Props {
  href: string;
  label: string;
  class?: string;
}

const { href, label, class: className = "" } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "btn-destination",
    "flex w-full max-w-[528px] min-h-[50px] sm:min-h-[60px] items-center justify-center gap-1.5 sm:gap-3 rounded-full border border-white/40 px-3 sm:px-6",
    "transition-colors duration-200",
    className,
  ]}
>
  <span class="btn-destination__icon shrink-0" aria-hidden="true">
    <img
      src={withBase("/brand/paw-icon-light.svg")}
      alt=""
      width="21"
      height="18"
      class="btn-destination__paw btn-destination__paw--default"
    />
    <img
      src={withBase("/brand/paw-icon-duotone.svg")}
      alt=""
      width="21"
      height="18"
      class="btn-destination__paw btn-destination__paw--hover"
    />
  </span>
  <span
    class="font-body font-medium whitespace-nowrap text-[14px] sm:text-base"
  >
    {label}
  </span>
</a>
