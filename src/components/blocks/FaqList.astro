---
import GhostLink from "@/components/blocks/GhostLink.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import type { FaqItem } from "@/data/faqs";

interface Props {
  headingId: string;
  heading: string;
  subtitle?: string;
  items: readonly FaqItem[];
  more?: { href: string; label: string };
  class?: string;
  hideSubtitleOnDesktop?: boolean;
}

const {
  headingId,
  heading,
  subtitle,
  items,
  more,
  class: className = "!pt-size-9 !pb-size-15 lg:!pt-size-13",
  hideSubtitleOnDesktop = false,
} = Astro.props;
---

<Section class={className} ariaLabelledby={headingId}>
  <Container>
    <div data-faq-root>
      <header class="pb-size-7">
        <h2 id={headingId} class="type-h2 pb-size-7 lg:pb-0">
          {heading}
        </h2>
        {subtitle && (
          <p
            class:list={[
              "type-subtitle pb-size-9 font-normal text-subtitle",
              hideSubtitleOnDesktop && "lg:hidden",
            ]}
          >
            {subtitle}
          </p>
        )}
      </header>

      <div class="flex flex-col">
        {items.map((item, index) => {
          const panelId = `${headingId}-panel-${index}`;
          const triggerId = `${headingId}-trigger-${index}`;

          return (
            <div class="border-b border-stroke-strong" data-faq-item>
              <button
                type="button"
                id={triggerId}
                class="w-full cursor-pointer pt-size-7 pb-size-6 text-left"
                aria-expanded="false"
                aria-controls={panelId}
                data-faq-toggle
              >
                <span class="flex items-start justify-between gap-size-6">
                  <span class="type-h5 min-w-0 flex-1 pr-size-7 text-heading">
                    {item.question}
                  </span>

                  <span
                    class="relative size-6 shrink-0 text-highlighted"
                    aria-hidden="true"
                  >
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      class="absolute inset-0 size-6 transition-opacity duration-300 ease-out motion-reduce:transition-none"
                      data-faq-icon-plus
                    >
                      <path
                        d="M12 5v14M5 12h14"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                      />
                    </svg>
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      class="absolute inset-0 size-6 opacity-0 transition-opacity duration-300 ease-out motion-reduce:transition-none"
                      data-faq-icon-minus
                    >
                      <path
                        d="M5 12h14"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                      />
                    </svg>
                  </span>
                </span>
              </button>

              <div
                id={panelId}
                class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out motion-reduce:transition-none"
                role="region"
                aria-labelledby={triggerId}
                data-faq-panel
                inert
              >
                <div class="min-h-0 overflow-hidden">
                  <p
                    class="type-paragraph-m max-w-prose pb-size-6 pt-size-6 text-body opacity-0 transition-opacity duration-300 ease-out motion-reduce:transition-none"
                    data-faq-answer
                  >
                    {item.answer}
                  </p>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      {more && (
        <div class="flex justify-end pt-size-7">
          <GhostLink href={more.href} label={more.label} />
        </div>
      )}
    </div>
  </Container>
</Section>

<script>
  function setFaqExpanded(trigger: HTMLButtonElement, expanded: boolean) {
    trigger.setAttribute("aria-expanded", String(expanded));

    const panelId = trigger.getAttribute("aria-controls");
    const panel = panelId ? document.getElementById(panelId) : null;
    if (!(panel instanceof HTMLElement)) return;

    if (expanded) {
      panel.removeAttribute("inert");
    } else {
      panel.setAttribute("inert", "");
    }
  }

  function initFaqs() {
    document.querySelectorAll("[data-faq-root]").forEach((root) => {
      root.querySelectorAll("[data-faq-toggle]").forEach((node) => {
        if (!(node instanceof HTMLButtonElement)) return;
        if (node.dataset.bound === "true") return;
        node.dataset.bound = "true";

        node.addEventListener("click", () => {
          const isExpanded = node.getAttribute("aria-expanded") === "true";
          setFaqExpanded(node, !isExpanded);
        });
      });
    });
  }

  initFaqs();
  document.addEventListener("astro:page-load", initFaqs);
</script>

<style is:global>
  [data-faq-item]:has([data-faq-toggle][aria-expanded="true"])
    [data-faq-panel] {
    grid-template-rows: 1fr;
  }
  [data-faq-item]:has([data-faq-toggle][aria-expanded="true"])
    [data-faq-answer] {
    opacity: 1;
  }
  [data-faq-toggle][aria-expanded="true"] [data-faq-icon-plus] {
    opacity: 0;
  }
  [data-faq-toggle][aria-expanded="true"] [data-faq-icon-minus] {
    opacity: 1;
  }
</style>
