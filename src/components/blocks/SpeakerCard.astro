---
import SpeakerCardIdentity from "@/components/blocks/SpeakerCardIdentity.astro";
import Icon from "@/components/ui/Icon.astro";
import type { Speaker } from "@/data/speakers";
import { mapSocialItems } from "@/types/social";

interface Props {
  speaker: Speaker;
  talk?: { id: string; title: string };
}

const { speaker, talk } = Astro.props;

const biography = speaker.biography?.trim() ?? "";
const fullName = `${speaker.name} ${speaker.lastName}`.trim();
const socialItems = mapSocialItems(speaker.socials);
const hasSocials = socialItems.some((item) => Boolean(item.href));
const hasExtraContent = Boolean(biography || hasSocials || talk);
const panelId = `speaker-panel-${speaker.id}`;
const triggerId = `speaker-trigger-${speaker.id}`;
const headingId = `speaker-name-${speaker.id}`;
---

<li
  id={`speaker-${speaker.id}`}
  class="group/speaker-card relative z-0 w-full border-b border-stroke-strong"
  data-speaker-card
  data-expanded="false"
>
  <article
    class:list={[
      "speaker-article relative w-full border border-transparent py-size-5 transition-all duration-300 ease-out lg:p-size-6",
      hasExtraContent && "cursor-pointer",
    ]}
  >
    <div class="grid grid-cols-[100px_minmax(0,1fr)_auto] items-start gap-x-size-6 lg:grid-cols-[144px_minmax(0,1fr)_auto] lg:gap-x-size-7">
      <SpeakerCardIdentity
        speaker={speaker}
        fullName={fullName}
        headingId={headingId}
      />

      {hasExtraContent && (
        <button
          type="button"
          id={triggerId}
          class="col-start-3 row-start-1 flex items-center justify-end self-center text-heading focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand lg:row-span-2 lg:items-end lg:self-end group-data-[expanded=true]/speaker-card:max-lg:col-span-full group-data-[expanded=true]/speaker-card:max-lg:col-start-1 group-data-[expanded=true]/speaker-card:max-lg:row-start-3 group-data-[expanded=true]/speaker-card:max-lg:mt-size-6 group-data-[expanded=true]/speaker-card:max-lg:w-full group-data-[expanded=true]/speaker-card:max-lg:border-t group-data-[expanded=true]/speaker-card:max-lg:border-stroke-strong group-data-[expanded=true]/speaker-card:max-lg:pt-size-4 group-data-[expanded=true]/speaker-card:max-lg:self-end"
          aria-expanded="false"
          aria-controls={panelId}
          aria-label={`Mostrar información de ${fullName}`}
          data-speaker-toggle
          data-speaker-name={fullName}
        >
          <span
            class="inline-flex size-10 items-center justify-center"
            aria-hidden="true"
          >
            <svg
              width="15"
              height="18"
              viewBox="0 0 15 18"
              fill="none"
              class="size-6 transition-transform duration-300 ease-out motion-reduce:transition-none"
              data-speaker-arrow
            >
              <path
                d="M7.5 1V16.5M1.5 10.5L7.5 16.5L13.5 10.5"
                stroke="currentColor"
                stroke-width="1.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </button>
      )}

      {hasExtraContent && (
        <div
          id={panelId}
          class="col-span-full row-start-2 grid min-w-0 grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out motion-reduce:transition-none lg:col-span-1 lg:col-start-2"
          role="region"
          aria-labelledby={headingId}
          data-speaker-panel
          inert
        >
          <div class="min-h-0 overflow-hidden">
            <div
              class="pt-size-7 opacity-0 transition-opacity duration-300 ease-out motion-reduce:transition-none lg:pt-size-6"
              data-speaker-panel-content
            >
              {biography && (
                <p class="font-body text-[15px] leading-[1.5] whitespace-pre-line text-subtitle lg:text-[16px]">
                  {biography}
                </p>
              )}

              {hasSocials && (
                <ul class="flex list-none items-center gap-size-6 p-0 pt-size-7">
                  {socialItems.map(({ href, label, icon }) => (
                    <li>
                      {href ? (
                        <a
                          href={href}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`${label} de ${fullName}`}
                          class="inline-flex size-8 items-center justify-center text-heading transition-colors hover:text-brand"
                        >
                          <Icon name={icon} size={28} />
                        </a>
                      ) : null}
                    </li>
                  ))}
                </ul>
              )}

              {talk && (
                <a
                  href={`/agenda#${talk.id}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-size-7 inline-flex items-start gap-2 font-body text-[16px] leading-snug text-heading underline-offset-4 hover:text-brand hover:underline"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    class="mt-0.5 size-[18px] shrink-0"
                    aria-hidden="true"
                  >
                    <path
                      d="M10 13a5 5 0 0 0 7.07.07l2.83-2.83a5 5 0 0 0-7.07-7.07L11.2 4.8"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                    />
                    <path
                      d="M14 11a5 5 0 0 0-7.07-.07L4.1 13.76a5 5 0 0 0 7.07 7.07l1.63-1.63"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                    />
                  </svg>
                  <span>{talk.title}</span>
                </a>
              )}
            </div>
          </div>
        </div>
      )}
    </div>
  </article>
</li>

<style>
  [data-speaker-card][data-expanded="true"] {
    z-index: 20;
  }
  [data-speaker-card][data-expanded="true"] [data-speaker-panel] {
    grid-template-rows: 1fr;
  }
  [data-speaker-card][data-expanded="true"] [data-speaker-panel-content] {
    opacity: 1;
  }
  [data-speaker-card][data-expanded="true"] [data-speaker-arrow] {
    transform: rotate(180deg);
  }
</style>
