---
import GhostLink from "@/components/blocks/GhostLink.astro";
import CarouselNavButton from "@/components/ui/CarouselNavButton.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import type { Speaker } from "@/data/speakers";
import { withBase } from "@/utils/path";

interface Props {
  speakers: Speaker[];
  eyebrow?: string;
  heading?: string;
  viewAllHref?: string;
  viewAllLabel?: string;
}

const {
  speakers,
  eyebrow = "Ponentes",
  heading = "Los referentes detrás del tech que usas",
  viewAllHref = "#speakers-heading",
  viewAllLabel = "Ver todos los ponentes",
} = Astro.props;

const hasSpeakers = speakers.length > 0;
---

<Section
  class="!pt-size-8 !pb-size-6 lg:!pt-size-10 lg:!pb-size-8"
  ariaLabelledby="speakers-heading"
>
  <Container>
    <div data-speakers-section>
      <header class="py-size-8 lg:pb-size-8 lg:pt-0">
        <p
          class="type-eyebrow-medium pb-size-6 font-body uppercase text-highlighted"
        >
          {eyebrow}
        </p>

        <h2 id="speakers-heading" class="type-h2 max-w-[700px] font-display">
          {heading}
        </h2>
      </header>

      {
        hasSpeakers ? (
          <>
            <div class="flex items-center justify-between pb-size-6 pt-size-4 lg:justify-end lg:gap-[20px] lg:pb-size-8">
              <div
                class="flex items-center gap-[4px] font-body text-[14px] font-medium leading-[1.2] tracking-[0] text-[#D5CABF] tabular-nums lg:text-[20px]"
                aria-live="polite"
                aria-atomic="true"
              >
                <span data-speaker-counter>1</span>
                <span>de</span>
                <span>{speakers.length}</span>
              </div>

              <div class="flex items-center gap-[12px] lg:gap-[16px]">
                <CarouselNavButton
                  direction="prev"
                  class="speaker-prev"
                  aria-label="Ponente anterior"
                />
                <CarouselNavButton
                  direction="next"
                  class="speaker-next"
                  aria-label="Siguiente ponente"
                />
              </div>
            </div>

            <div
              class="speaker-carousel relative flex h-[388px] w-full cursor-grab select-none snap-x snap-mandatory gap-[16px] overflow-x-auto overflow-y-hidden scroll-smooth [-ms-overflow-style:none] [scrollbar-width:none] active:cursor-grabbing lg:h-[424px] lg:gap-[24px] [&::-webkit-scrollbar]:hidden"
              role="region"
              aria-label="Carrusel de ponentes"
            >
              {speakers.map((speaker) => (
                <article
                  id={`speaker-${speaker.id}`}
                  class="flex h-[388px] min-h-[388px] w-[274px] flex-none snap-start flex-col overflow-hidden rounded-none border border-[#272421] bg-[#1A1814] lg:h-[424px] lg:min-h-[424px] lg:w-[300px]"
                  data-speaker-card
                >
                  <img
                    src={withBase(speaker.image)}
                    alt={`Retrato de ${speaker.name} ${speaker.lastName}`}
                    width="274"
                    height="274"
                    class="pointer-events-none h-[274px] w-[274px] flex-none object-cover rounded-none lg:h-[300px] lg:w-[300px]"
                    loading="lazy"
                  />
                  <div class="flex flex-1 flex-col justify-center gap-[4px] p-size-4">
                    <h3 class="w-full font-display text-[20px] font-medium leading-[1.1] tracking-[0] text-heading lg:text-[24px]">
                      {speaker.name} {speaker.lastName}
                    </h3>

                    <div class="flex w-full items-center gap-[4px] font-body text-[14px] text-muted lg:text-[16px]">
                      <span>{speaker.role}</span>
                    </div>
                  </div>
                </article>
              ))}
            </div>

            <div class="flex justify-end pt-size-5 lg:pt-size-8">
              <GhostLink href={viewAllHref} label={viewAllLabel} />
            </div>
          </>
        ) : (
          <p class="py-size-8 type-paragraph-l text-muted">
            No hay ponentes disponibles.
          </p>
        )
      }
    </div>
  </Container>
</Section>

<script>
  function initializeSpeakersCarousels() {
    const sections = document.querySelectorAll<HTMLElement>(
      "[data-speakers-section]"
    );

    sections.forEach((section) => {
      if (section.dataset.bound === "true") {
        return;
      }

      const carousel = section.querySelector<HTMLElement>(".speaker-carousel");
      const previousButton =
        section.querySelector<HTMLButtonElement>(".speaker-prev");
      const nextButton =
        section.querySelector<HTMLButtonElement>(".speaker-next");
      const counter = section.querySelector<HTMLElement>(
        "[data-speaker-counter]"
      );
      const cards = Array.from(
        section.querySelectorAll<HTMLElement>("[data-speaker-card]")
      );

      if (
        !carousel ||
        !previousButton ||
        !nextButton ||
        !counter ||
        cards.length === 0
      ) {
        return;
      }

      section.dataset.bound = "true";

      const realCount = cards.length;
      const looping = realCount > 1;

      if (looping) {
        const startClones = document.createDocumentFragment();
        const endClones = document.createDocumentFragment();

        cards.forEach((card) => {
          const startClone = card.cloneNode(true) as HTMLElement;
          const endClone = card.cloneNode(true) as HTMLElement;

          [startClone, endClone].forEach((clone) => {
            clone.removeAttribute("id");
            clone.setAttribute("aria-hidden", "true");
            clone.dataset.speakerClone = "true";
          });

          startClones.appendChild(startClone);
          endClones.appendChild(endClone);
        });

        carousel.insertBefore(startClones, carousel.firstChild);
        carousel.appendChild(endClones);
        cards.splice(
          0,
          cards.length,
          ...section.querySelectorAll<HTMLElement>("[data-speaker-card]")
        );
      }

      let currentIndex = looping ? realCount : 0;
      let targetIndex = currentIndex;
      let scrollFrame: number | undefined;
      let settleTimer: number | undefined;
      let isJumping = false;
      let isProgrammaticScroll = false;

      let isMouseDown = false;
      let startX = 0;
      let scrollLeft = 0;

      const realIndex = (index: number) =>
        ((index % realCount) + realCount) % realCount;

      const scrollLeftFor = (index: number) => {
        const carouselRect = carousel.getBoundingClientRect();
        const cardRect = cards[index].getBoundingClientRect();
        return carousel.scrollLeft + (cardRect.left - carouselRect.left);
      };

      const updateControls = () => {
        counter.textContent = String(realIndex(currentIndex) + 1);
        previousButton.disabled = !looping && currentIndex === 0;
        nextButton.disabled = !looping && currentIndex === realCount - 1;
      };

      const closestCardIndex = () => {
        const carouselLeft = carousel.getBoundingClientRect().left;
        let closestIndex = currentIndex;
        let closestDistance = Number.POSITIVE_INFINITY;

        cards.forEach((card, index) => {
          const distance = Math.abs(
            card.getBoundingClientRect().left - carouselLeft
          );

          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });

        return closestIndex;
      };

      const jumpToIndex = (index: number) => {
        isJumping = true;
        currentIndex = index;
        targetIndex = index;
        carousel.classList.remove("scroll-smooth", "snap-x");
        carousel.scrollLeft = scrollLeftFor(index);
        carousel.classList.add("scroll-smooth", "snap-x");
        updateControls();
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            isJumping = false;
          });
        });
      };

      const normalizeLoop = () => {
        if (!looping || isJumping) return;

        if (currentIndex >= realCount * 2) {
          jumpToIndex(currentIndex - realCount);
        } else if (currentIndex < realCount) {
          jumpToIndex(currentIndex + realCount);
        }
      };

      const scrollToCard = (index: number) => {
        isProgrammaticScroll = true;
        targetIndex = Math.max(0, Math.min(index, cards.length - 1));
        currentIndex = targetIndex;
        updateControls();
        carousel.classList.remove("snap-x");
        carousel.scrollTo({
          left: scrollLeftFor(targetIndex),
          behavior: "smooth",
        });
      };

      const updateCurrentCard = () => {
        if (isJumping || isProgrammaticScroll) return;

        const closestIndex = closestCardIndex();

        if (closestIndex !== currentIndex) {
          currentIndex = closestIndex;
          targetIndex = closestIndex;
          updateControls();
        }
      };

      const stopDragging = () => {
        if (!isMouseDown) return;
        isMouseDown = false;
        carousel.classList.add("scroll-smooth", "snap-x");
        finishScroll();
      };

      carousel.addEventListener("mousedown", (e) => {
        if (e.button !== 0) return;
        e.preventDefault();
        isMouseDown = true;
        window.clearTimeout(settleTimer);
        carousel.classList.remove("scroll-smooth", "snap-x");
        startX = e.pageX - carousel.offsetLeft;
        scrollLeft = carousel.scrollLeft;
      });

      window.addEventListener("mouseup", stopDragging);

      window.addEventListener("mousemove", (e) => {
        if (!isMouseDown) return;
        e.preventDefault();
        const x = e.pageX - carousel.offsetLeft;
        const walk = (x - startX) * 1.5;
        carousel.scrollLeft = scrollLeft - walk;
      });

      previousButton.addEventListener("click", () => {
        scrollToCard(targetIndex - 1);
      });

      nextButton.addEventListener("click", () => {
        scrollToCard(targetIndex + 1);
      });

      const finishScroll = () => {
        if (isMouseDown || isJumping) return;
        isProgrammaticScroll = false;
        carousel.classList.add("snap-x");
        currentIndex = closestCardIndex();
        targetIndex = currentIndex;
        updateControls();
        normalizeLoop();
      };

      carousel.addEventListener(
        "scroll",
        () => {
          if (scrollFrame !== undefined) {
            cancelAnimationFrame(scrollFrame);
          }

          scrollFrame = requestAnimationFrame(updateCurrentCard);
          window.clearTimeout(settleTimer);
          settleTimer = window.setTimeout(finishScroll, 140);
        },
        { passive: true }
      );

      carousel.addEventListener("scrollend", finishScroll);

      if (looping) {
        jumpToIndex(realCount);
      } else {
        updateControls();
      }
    });
  }

  initializeSpeakersCarousels();

  document.addEventListener("astro:page-load", initializeSpeakersCarousels);
</script>
