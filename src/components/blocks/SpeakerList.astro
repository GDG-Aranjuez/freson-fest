---
import CtaNote from "@/components/blocks/CtaNote.astro";
import SpeakerCard from "@/components/blocks/SpeakerCard.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import type { Speaker } from "@/data/speakers";

interface Props {
  speakers: Speaker[];
  heading: string;
  ticketsCta: { href: string; label: string };
  ticketsFootnote: string;
}

const { speakers, heading, ticketsCta, ticketsFootnote } = Astro.props;

const hasSpeakers = speakers.length > 0;
---

<Section class="!pt-size-13 !pb-size-15" ariaLabelledby="speaker-list-heading">
  <Container class="mx-auto max-w-[1200px]">
    <div class="mx-auto w-full max-w-[480px] lg:max-w-none">
      <header class="pb-size-7 text-left">
        <h2
          id="speaker-list-heading"
          class="type-h2 text-heading max-w-[750px] font-display
            font-semibold text-[32px] leading-[1.1]"
        >
          <span aria-hidden="true" class="lg:hidden">
            {heading}
          </span>
          <span class="sr-only">
            {heading}
          </span>
        </h2>

        <p
          class="hidden pt-size-8 font-['Plus_Jakarta_Sans'] text-[18px]
            font-medium uppercase leading-none tracking-normal
            text-[#F37D16] lg:block"
        >
          {heading}
        </p>
      </header>

      {
        hasSpeakers ? (
          <ul class="flex w-full list-none flex-col p-0">
            {speakers.map((speaker) => (
              <SpeakerCard speaker={speaker} />
            ))}
          </ul>
        ) : (
          <p class="pt-size-6 font-body text-[16px] text-[#D5CABF]">
            No hay ponentes disponibles.
          </p>
        )
      }

      <div
        class="mx-auto flex w-full max-w-[343px] flex-col
          items-center pt-size-13 lg:max-w-[320px]"
      >
        <CtaNote
          href={ticketsCta.href}
          label={ticketsCta.label}
          footnote={ticketsFootnote}
          noteAlign="center"
          block={true}
        />
      </div>
    </div>
  </Container>
</Section>

<script>
  function setSpeakerExpanded(trigger: HTMLButtonElement, expanded: boolean) {
    trigger.setAttribute("aria-expanded", String(expanded));
    const card = trigger.closest("[data-speaker-card]");
    if (card instanceof HTMLElement) {
      card.dataset.expanded = String(expanded);
    }

    const speakerName = trigger.dataset.speakerName || "";
    if (expanded) {
      trigger.setAttribute(
        "aria-label",
        speakerName
          ? `Ocultar información de ${speakerName}`
          : "Ocultar información"
      );
    } else {
      trigger.setAttribute(
        "aria-label",
        speakerName
          ? `Mostrar información de ${speakerName}`
          : "Mostrar información"
      );
    }

    const panelId = trigger.getAttribute("aria-controls");
    const panel = panelId ? document.getElementById(panelId) : null;
    if (!(panel instanceof HTMLElement)) return;

    if (expanded) {
      panel.removeAttribute("inert");
    } else {
      panel.setAttribute("inert", "");
    }
  }

  function collapseOtherSpeakerCards(currentTrigger: HTMLButtonElement) {
    document
      .querySelectorAll<HTMLButtonElement>("[data-speaker-toggle]")
      .forEach((trigger) => {
        if (trigger !== currentTrigger) {
          setSpeakerExpanded(trigger, false);
        }
      });
  }

  function initSpeakerCards() {
    document.querySelectorAll("[data-speaker-card]").forEach((card) => {
      if (!(card instanceof HTMLElement)) return;
      if (card.dataset.bound === "true") return;
      card.dataset.bound = "true";

      card.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        if (event.target.closest("a")) return;

        const trigger = card.querySelector("[data-speaker-toggle]");
        if (!(trigger instanceof HTMLButtonElement)) return;

        const isExpanded = trigger.getAttribute("aria-expanded") === "true";

        if (!isExpanded) {
          collapseOtherSpeakerCards(trigger);
        }
        setSpeakerExpanded(trigger, !isExpanded);
      });
    });
  }

  initSpeakerCards();
  document.addEventListener("astro:page-load", initSpeakerCards);
</script>
