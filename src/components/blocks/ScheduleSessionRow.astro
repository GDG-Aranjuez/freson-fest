---
import type { AgendaSession } from "@/data/agenda";
import AgendaNetworkingRow from "./AgendaNetworkingRow.astro";

interface Props {
  session: AgendaSession;
}

const { session } = Astro.props;

const isNetworking =
  session.type === "Networking" ||
  (!session.speaker && !session.role && !session.speakers);

const hasExpandableContent = Boolean(session.description);
---

{isNetworking ? (
  <AgendaNetworkingRow session={session} />
) : (
  <div class="agenda-card group relative flex w-full flex-col md:flex-row items-start justify-start border border-[#272421] bg-[#171512] px-4 md:px-6 py-4 md:py-5 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:z-30 hover:-translate-y-1 hover:border-brand hover:bg-[#1a1714] hover:shadow-[0_10px_30px_rgba(255,158,102,0.18)] gap-4 md:gap-10 cursor-pointer">
    {/* Contenedor superior: Horas + Título */}
    <div class="flex flex-row items-start gap-4 md:contents w-full">
      {/* Izquierda: Horas */}
      <div class="flex shrink-0 flex-col items-center pt-0.5 w-[60px] md:w-[70px]">
        <time class="font-body text-[16px] md:text-[20px] font-regular text-center leading-none text-brand mt-2">
          {session.startTime}
        </time>
        <span class="mt-2 font-body text-[12px] md:text-[14px] font-regular text-center leading-none text-subtitle/50">
          {session.endTime}
        </span>
      </div>

      {/* Centro: Título, Descripción y Badge */}
      <div class="flex flex-1 flex-col min-w-0">
        <h3 class="font-display text-[16px] md:text-[24px] font-medium leading-snug text-heading">
          {session.title}
        </h3>

        {hasExpandableContent && (
          <div class="mobile-details hidden md:block transition-all duration-300 ease-in-out">
            {session.description && (
              <p class="mt-2 font-body text-[12px] md:text-[14px] font-regular leading-relaxed text-subtitle/70 max-w-[480px] whitespace-pre-line">
                {session.description}
              </p>
            )}
          </div>
        )}
      </div>
    </div>

    {/* Derecha: Ponente */}
    {((session.speakers && session.speakers.length > 0) ||
      (session.speaker && session.speaker !== "Por confirmar")) && (
      <div class="flex shrink-0 flex-col gap-3 w-full md:w-[300px] md:ml-auto md:self-start border-[#272421] md:border-t-0 pt-3 md:pt-0 mt-3 md:mt-0">
        {session.speakers ? (
          session.speakers.map((s) => (
            <div class="flex items-center gap-3 min-w-0">
              {s.image ? (
                <img
                  src={s.image}
                  alt={s.name}
                  class="h-10 w-10 md:h-12 md:w-12 rounded-full object-cover shrink-0 border border-[#272421]"
                />
              ) : (
                <div class="flex h-10 w-10 md:h-12 md:w-12 items-center justify-center rounded-full bg-[#272421] font-body text-xs font-medium text-heading shrink-0">
                  {s.name.slice(0, 2).toUpperCase()}
                </div>
              )}
              <div class="flex flex-col text-left min-w-0">
                <span class="font-body text-[14px] md:text-[18px] font-medium leading-tight text-heading truncate">
                  {s.name}
                </span>
                {s.role && (
                  <span class="mt-0.5 font-body text-[12px] md:text-[14px] font-medium leading-tight text-brand truncate">
                    {s.role}
                  </span>
                )}
                {s.company && (
                  <span class="mt-0.5 font-body text-[12px] md:text-[14px] leading-tight text-subtitle/60 truncate">
                    {s.company}
                  </span>
                )}
              </div>
            </div>
          ))
        ) : (
          <div class="flex items-center gap-3 min-w-0">
            {session.image ? (
              <img
                src={session.image}
                alt={session.speaker}
                class="h-10 w-10 md:h-14 md:w-14 rounded-full object-cover shrink-0 border border-[#272421]"
              />
            ) : (
              <div class="flex h-10 w-10 md:h-14 md:w-14 items-center justify-center rounded-full bg-[#272421] font-body text-xs font-medium text-heading shrink-0">
                {session.speaker?.slice(0, 2).toUpperCase()}
              </div>
            )}
            <div class="flex flex-col text-left min-w-0">
              <span class="font-body text-[14px] md:text-[20px] font-medium leading-tight text-heading truncate">
                {session.speaker}
              </span>
              {session.role && (
                <span class="mt-0.5 font-body text-[12px] md:text-[16px] font-medium leading-tight text-brand truncate">
                  {session.role}
                </span>
              )}
              {session.company && (
                <span class="mt-0.5 font-body text-[12px] md:text-[16px] leading-tight text-subtitle/60 truncate">
                  {session.company}
                </span>
              )}
            </div>
          </div>
        )}
      </div>
    )}

    {/* Ícono '+' */}
    {hasExpandableContent && (
      <div class="expand-icon absolute bottom-3 right-4 md:hidden text-subtitle/40 text-xl font-light select-none pointer-events-none transition-transform duration-300">
        +
      </div>
    )}
  </div>
)}

<script>
  function initAgendaCards() {
    document.querySelectorAll(".agenda-card").forEach((card) => {
      if (!card.hasAttribute("data-expand-init")) {
        card.setAttribute("data-expand-init", "true");
        card.addEventListener("click", () => {
          if (window.innerWidth < 768) {
            const details = card.querySelector(".mobile-details");
            const icon = card.querySelector(".expand-icon");
            if (details) {
              const isHidden = details.classList.toggle("hidden");

              // Borde y sombra naranja al expandir
              card.classList.toggle("border-brand", !isHidden);
              card.classList.toggle(
                "shadow-[0_10px_30px_rgba(255,158,102,0.18)]",
                !isHidden
              );
              card.classList.toggle("bg-[#1a1714]", !isHidden);

              if (icon) {
                icon.textContent = isHidden ? "+" : "−";
              }
            }
          }
        });
      }
    });
  }

  // Inicializar al cargar el DOM inicialmente
  document.addEventListener("DOMContentLoaded", initAgendaCards);

  // Inicializar cada vez que Astro cargue una nueva página vía View Transitions
  document.addEventListener("astro:page-load", initAgendaCards);
</script>
