---
import Icon from "@/components/ui/Icon.astro";
import type { TeamMember } from "@/data/team";
import { mapSocialItems } from "@/types/social";
import { withBase } from "@/utils/path";

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
const socialItems = mapSocialItems(member.socials);
const memberDetails = [member.role, member.company, member.projectRole]
  .filter(Boolean)
  .join(" · ");
---

<article class="group relative z-0 box-border h-[146px] w-full overflow-visible border-b border-stroke-strong py-size-5 pr-size-2 hover:z-10 hover:border-transparent lg:h-[172px] lg:py-size-4">
  <div class="flex h-full items-center border border-transparent bg-transparent transition-[margin,padding,border-color,box-shadow,background-color] duration-200 group-hover:-m-size-4 group-hover:border-[var(--palette-orange-500)] group-hover:bg-page group-hover:p-size-4 group-hover:shadow-card-hover">
    <div class="flex h-full w-[110px] shrink-0 items-center py-size-3 lg:w-[156px] lg:py-size-4 lg:pl-size-6">
      <div class="relative size-[110px] shrink-0 overflow-hidden lg:size-[140px]">
        <img
          src={withBase(member.image)}
          alt={member.name}
          width="140"
          height="140"
          class="size-full object-cover"
          loading="lazy"
        />
        <div
          class="absolute inset-0 bg-[rgba(197,70,0,0.05)]"
          aria-hidden="true"
        ></div>
      </div>
    </div>

    <div class="flex h-full min-w-0 flex-1 flex-col py-size-2 lg:py-size-4">
      <div class="flex min-h-0 flex-1 flex-col gap-size-4 overflow-hidden pb-size-5 pl-size-6 pr-size-7 pt-size-1 lg:gap-size-5">
        <h3 class="font-display text-[20px] font-medium leading-[1.1] text-heading lg:text-[24px]">
          {member.name}
        </h3>
        <p class="font-body text-[14px] font-medium leading-[1.2] text-subtitle lg:text-[16px]">
          {memberDetails}
        </p>
      </div>

      <ul class="flex h-8 list-none items-center gap-size-5 p-0 px-size-5 lg:gap-size-7 lg:px-size-6">
        {socialItems.map(({ href, label, icon }) => {
          const className =
            "relative flex size-8 items-center justify-center text-heading";
          const icons = (
            <>
              <span class="lg:hidden">
                <Icon name={icon} size={24} />
              </span>
              <span class="absolute left-[-2px] top-[-2px] hidden size-9 lg:block">
                <Icon name={icon} size={36} />
              </span>
            </>
          );

          return (
            <li class="size-8">
              {href ? (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${label} de ${member.name}`}
                  class:list={[className, "transition-colors hover:text-brand"]}
                >
                  {icons}
                </a>
              ) : (
                <span class={className} aria-hidden="true">
                  {icons}
                </span>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</article>
