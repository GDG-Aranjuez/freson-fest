---
import Icon from "@/components/ui/Icon.astro";
import type { TeamMember } from "@/data/team";
import { mapSocialItems } from "@/types/social";
import { withBase } from "@/utils/path";

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
const socialItems = mapSocialItems(member.socials);
---

<article class="flex h-full min-h-[340px] flex-col overflow-hidden rounded-lg bg-surface">
  <div class="aspect-square w-full overflow-hidden">
    <img
      src={withBase(member.image)}
      alt={member.imageAlt ?? member.name}
      width="400"
      height="400"
      class="size-full object-cover"
      loading="lazy"
    />
  </div>

  <div class="flex min-h-[112px] flex-1 flex-col items-start gap-size-3 p-size-6">
    <h3 class="font-display text-[20px] font-semibold leading-[1.1] text-heading">
      {member.name}
    </h3>
    <p class="font-body text-[14px] font-medium leading-[1.3] text-highlighted">
      {member.role}
    </p>
    {member.company && (
      <p class="font-body text-[12px] leading-[1.3] text-muted">
        {member.company}
      </p>
    )}
    {socialItems.length > 0 && (
      <ul class="mt-auto flex list-none items-center gap-size-3 p-0">
        {socialItems.map(({ href, label, icon }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${label} de ${member.name}`}
              class="inline-flex size-9 items-center justify-center text-heading transition-colors hover:text-highlighted"
            >
              <Icon name={icon} size={24} />
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
