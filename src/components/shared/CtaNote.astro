---
import Button from "@/components/ui/Button.astro";

interface Props {
  href: string;
  label: string;
  footnote: string;
  class?: string;
  block?: boolean;
  noteAlign?: "center" | "start";
}

const {
  href,
  label,
  footnote,
  class: className = "",
  block = true,
  noteAlign = "center",
} = Astro.props;
---

<div class:list={["font-body flex w-full flex-col items-stretch", className]}>
  <Button href={href} block={block}>
    {label}
  </Button>
  <p
    class:list={[
      "type-caption py-size-6 font-medium text-body",
      noteAlign === "start" ? "text-center lg:text-left" : "text-center",
    ]}
  >
    {footnote}
  </p>
</div>
