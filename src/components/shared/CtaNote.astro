---
import Button from "@/components/ui/Button.astro";

interface Props {
  href: string;
  label: string;
  footnote: string;
  class?: string;
  block?: boolean;
  noteAlign?: "center" | "start";
  variant?: "default" | "agenda";
}

const {
  href,
  label,
  footnote,
  class: className = "",
  block = true,
  noteAlign = "center",
  variant = "default",
} = Astro.props;

const isAgenda = variant === "agenda";
---

<div class:list={["font-body flex w-full flex-col items-stretch", className]}>
  <Button href={href} block={block}>
    {label}
  </Button>

  <p
    class:list={[
      "py-size-6 font-medium",
      isAgenda
        ? "font-['Plus_Jakarta_Sans'] text-[14px] leading-[120%] tracking-normal text-[#D5CABF] lg:text-[16px]"
        : "type-caption text-body",
      noteAlign === "start" ? "text-center lg:text-left" : "text-center",
    ]}
  >
    {footnote}
  </p>
</div>
