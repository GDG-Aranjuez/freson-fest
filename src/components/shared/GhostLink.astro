---
import { withBase } from "@/utils/path";

interface Props {
  href: string;
  label: string;
  class?: string;
  external?: boolean;
  underline?: boolean;
  iconPosition?: "right" | "left";
}

const {
  href,
  label,
  class: className = "",
  external = false,
  underline = true,
  iconPosition = "right",
} = Astro.props;

const resolvedHref =
  external || href.startsWith("http") ? href : withBase(href);
const isExternal = external || href.startsWith("http");
---

<a
  href={resolvedHref}
  class:list={[
    "inline-flex items-center gap-2 w-fit uppercase font-body text-[var(--color-action-ghost-text)] text-[14px] font-body font-medium leading-none tracking-[0.05em] no-underline pb-[4px]",
    underline && "border-b border-[var(--color-action-ghost-text)]",
    iconPosition === "left" && "flex-row-reverse",
    className,
  ]}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
>
  <span>{label}</span>
  <svg
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
    class="size-6 shrink-0"
  >
    <path
      d="M7 17L17 7M17 7H9M17 7V15"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</a>
