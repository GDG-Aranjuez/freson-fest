---
import GhostLink from "@/components/shared/GhostLink.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { faqs } from "@/data/agenda";
---

<Section class="!pt-size-13 !pb-size-15" ariaLabelledby="agenda-faqs-heading">
  <Container class="max-w-[1200px] mx-auto">
    <header class="pb-size-7">
      <h2
        id="agenda-faqs-heading"
        class="type-h2 pb-size-2 font-display font-semibold text-[32px] lg:text-[40px] leading-[1.1] mb-2"
      >
        {faqs.heading}
      </h2>
      <p
        class="type-subtitle pb-size-7 font-body font-normal text-subtitle/70 text-[14px] lg:text-[20px] leading-[1.4] lg:leading-[1.2]"
      >
        {faqs.subtitle}
      </p>
    </header>

    <div class="flex flex-col">
      {
        faqs.items.map((item, index) => {
          const panelId = `faq-panel-${index}`;
          const triggerId = `faq-trigger-${index}`;

          return (
            <div class="border-b border-stroke-strong">
              <button
                type="button"
                id={triggerId}
                class="group/faq w-full cursor-pointer py-6 lg:py-8 text-left"
                aria-expanded="false"
                aria-controls={panelId}
                data-faq-toggle
              >
                <span class="flex items-center justify-between gap-size-6">
                  <span class="font-display font-medium text-[18px] lg:text-[24px] leading-[1.2] lg:leading-[1.1] text-heading min-w-0 flex-1 pr-size-7">
                    {item.question}
                  </span>

                  <span
                    class="relative size-6 shrink-0 text-highlighted"
                    aria-hidden="true"
                  >
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      class="absolute inset-0 size-6 transition-opacity duration-300 ease-out group-aria-expanded/faq:opacity-0 motion-reduce:transition-none"
                    >
                      <path
                        d="M12 5v14M5 12h14"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                      />
                    </svg>
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      class="absolute inset-0 size-6 opacity-0 transition-opacity duration-300 ease-out group-aria-expanded/faq:opacity-100 motion-reduce:transition-none"
                    >
                      <path
                        d="M5 12h14"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                      />
                    </svg>
                  </span>
                </span>

                <span
                  id={panelId}
                  class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out group-aria-expanded/faq:grid-rows-[1fr] motion-reduce:transition-none"
                  role="region"
                  aria-labelledby={triggerId}
                  data-faq-panel
                  inert
                >
                  <span class="min-h-0 overflow-hidden">
                    <span class="type-paragraph-m block max-w-prose pt-size-4 lg:pt-size-6 text-[14px] lg:text-[16px] leading-[1.4] text-body opacity-0 transition-opacity duration-300 ease-out group-aria-expanded/faq:opacity-100 motion-reduce:transition-none">
                      {item.answer}
                    </span>
                  </span>
                </span>
              </button>
            </div>
          );
        })
      }
    </div>

    <div class="flex justify-end pt-size-7 mt-5">
      <GhostLink href={faqs.more.href} label={faqs.more.label} />
    </div>
  </Container>
</Section>

<script>
  function setFaqExpanded(trigger: HTMLButtonElement, expanded: boolean) {
    trigger.setAttribute("aria-expanded", String(expanded));

    const panelId = trigger.getAttribute("aria-controls");
    const panel = panelId ? document.getElementById(panelId) : null;
    if (!(panel instanceof HTMLElement)) return;

    if (expanded) {
      panel.removeAttribute("inert");
    } else {
      panel.setAttribute("inert", "");
    }
  }

  function initFaqs() {
    document.querySelectorAll("[data-faq-toggle]").forEach((node) => {
      if (!(node instanceof HTMLButtonElement)) return;
      if (node.dataset.bound === "true") return;
      node.dataset.bound = "true";

      node.addEventListener("click", () => {
        const isExpanded = node.getAttribute("aria-expanded") === "true";
        setFaqExpanded(node, !isExpanded);
      });
    });
  }

  initFaqs();
  document.addEventListener("astro:page-load", initFaqs);
</script>
