---
import { BackgroundRippleEffect } from "@/components/ui/BackgroundRippleEffect.tsx";
import CtaNote from "@/components/shared/CtaNote.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { sponsorsHero } from "@/data/sponsorsData";
---

<Section
  class="relative bg-page overflow-hidden !py-size-9 lg:!pt-size-13 lg:!pb-size-15"
  ariaLabelledby="hero-heading"
>
  <div
    class="absolute inset-0 z-0 pointer-events-auto flex items-center justify-center"
  >
    <div class="relative w-full max-w-[1200px] h-full mx-auto px-0 sm:px-4">
      <BackgroundRippleEffect client:idle />
      <div
        class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-page pointer-events-none"
      ></div>
    </div>
  </div>

  <Container
    class="relative z-10 w-full max-w-[1200px] mx-auto pointer-events-none"
  >
    <div class="flex flex-col items-start text-left lg:text-start">
      <div class="flex w-full max-w-[750px] flex-col items-start">
        <h1
          id="hero-heading"
          class="pb-size-6 lg:pb-size-9 font-display font-extrabold text-[48px] lg:text-[96px] leading-[1.05] text-start"
        >
          <span class="text-heading">{sponsorsHero.titleLead}{" "}</span>
          <span class="text-highlighted">{sponsorsHero.titleHighlight}</span>
        </h1>

        <p
          class="font-body text-[16px] lg:text-[20px] leading-[1.4] lg:leading-[1.2] font-normal max-w-[343px] lg:max-w-[480px] pb-size-8 lg:pb-size-12 text-left text-body/80"
        >
          {sponsorsHero.subtitle}
        </p>

        <div
          class="flex w-full sm:max-w-[320px] flex-col items-start pointer-events-auto"
        >
          <CtaNote
            href={sponsorsHero.cta.href}
            label={sponsorsHero.cta.label}
            footnote=""
            noteAlign="start"
            block={true}
          />
        </div>
      </div>
    </div>
  </Container>
</Section>
