---
import GhostLink from "@/components/shared/GhostLink.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { helpFaqs, helpHero } from "@/data/help";
---

<Section
  class="!py-size-13 lg:!pt-size-13 lg:!pb-size-16"
  ariaLabelledby="help-hero-heading"
>
  <Container class="max-w-[480px] lg:max-w-(--content-max)">
    <div class="flex flex-col items-start gap-size-0 text-left lg:pb-size-9">
      <p
        class="type-eyebrow-medium pb-size-6 w-full uppercase text-highlighted lg:hidden"
      >
        {helpHero.eyebrow}
      </p>

      <h1
        id="help-hero-heading"
        class="type-h1 w-full pb-size-7 font-extrabold"
      >
        {helpHero.title}
      </h1>

      <p
        class="type-subtitle w-full pb-size-12 font-normal text-subtitle lg:max-w-[480px]"
      >
        {helpHero.subtitle}
      </p>
    </div>

    <h2 class="type-h4 max-w-[780px] pb-size-6 text-heading">
      {helpFaqs.heading}
    </h2>

    <div class="flex flex-col text-left">
      {
        helpFaqs.items.map((item, index) => {
          const panelId = `help-faq-panel-${index}`;
          const triggerId = `help-faq-trigger-${index}`;

          return (
            <div class="border-b border-stroke-strong">
              <button
                type="button"
                id={triggerId}
                class="group/faq w-full cursor-pointer pt-size-7 pb-size-6 text-left"
                aria-expanded="false"
                aria-controls={panelId}
                data-faq-toggle
              >
                <span class="flex items-start justify-between gap-size-6">
                  <span class="type-h5 min-w-0 flex-1 pr-size-7 text-heading">
                    {item.question}
                  </span>

                  <span
                    class="relative size-6 shrink-0 text-highlighted lg:text-link"
                    aria-hidden="true"
                  >
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      class="absolute inset-0 size-6 transition-opacity duration-300 ease-out group-aria-expanded/faq:opacity-0 motion-reduce:transition-none"
                    >
                      <path
                        d="M12 5v14M5 12h14"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                      />
                    </svg>
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      class="absolute inset-0 size-6 opacity-0 transition-opacity duration-300 ease-out group-aria-expanded/faq:opacity-100 motion-reduce:transition-none"
                    >
                      <path
                        d="M5 12h14"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                      />
                    </svg>
                  </span>
                </span>

                <span
                  id={panelId}
                  class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out group-aria-expanded/faq:grid-rows-[1fr] motion-reduce:transition-none"
                  role="region"
                  aria-labelledby={triggerId}
                  data-faq-panel
                  inert
                >
                  <span class="min-h-0 overflow-hidden">
                    <span class="type-paragraph-m block max-w-prose pt-size-6 text-body opacity-0 transition-opacity duration-300 ease-out group-aria-expanded/faq:opacity-100 motion-reduce:transition-none">
                      {item.answer}
                    </span>
                  </span>
                </span>
              </button>
            </div>
          );
        })
      }
    </div>

    <div class="flex justify-end pt-size-7">
      <GhostLink href={helpFaqs.more.href} label={helpFaqs.more.label} />
    </div>
  </Container>
</Section>

<script>
  function setFaqExpanded(trigger: HTMLButtonElement, expanded: boolean) {
    trigger.setAttribute("aria-expanded", String(expanded));

    const panelId = trigger.getAttribute("aria-controls");
    const panel = panelId ? document.getElementById(panelId) : null;
    if (!(panel instanceof HTMLElement)) return;

    if (expanded) {
      panel.removeAttribute("inert");
    } else {
      panel.setAttribute("inert", "");
    }
  }

  function initFaqs() {
    document.querySelectorAll("[data-faq-toggle]").forEach((node) => {
      if (!(node instanceof HTMLButtonElement)) return;
      if (node.dataset.bound === "true") return;
      node.dataset.bound = "true";

      node.addEventListener("click", () => {
        const isExpanded = node.getAttribute("aria-expanded") === "true";
        setFaqExpanded(node, !isExpanded);
      });
    });
  }

  initFaqs();
  document.addEventListener("astro:page-load", initFaqs);
</script>
