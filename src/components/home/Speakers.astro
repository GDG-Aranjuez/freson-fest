---
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import GhostLink from "../shared/GhostLink.astro";
import Section from "@/components/ui/Section.astro";
import { speakers as defaultSpeakers } from "@/data/speakers";
import type { Speaker } from "@/types/speakers";
import { withBase } from "@/utils/path";

interface Props {
  speakers?: Speaker[];
  eyebrow?: string;
  heading?: string;
  viewAllHref?: string;
  viewAllLabel?: string;
}

const {
  speakers = defaultSpeakers,
  eyebrow = "Ponentes",
  heading = "Conoce a los referentes del tech que usas cada día.",
  viewAllHref = "#speakers-heading",
  viewAllLabel = "Ver todos los ponentes",
} = Astro.props;

const hasSpeakers = speakers.length > 0;
---

<Section
  class="bg-page !pt-size-13 !pb-size-9 lg:!pb-size-15"
  ariaLabelledby="speakers-heading"
>
  <Container>
    <div data-speakers-section>
      <header class="py-size-8 lg:pb-size-8 lg:pt-0">
        <p class="type-eyebrow-medium pb-size-6 uppercase text-highlighted">
          {eyebrow}
        </p>

        <h2 id="speakers-heading" class="type-h2 max-w-[700px]">
          {heading}
        </h2>
      </header>

      {
        hasSpeakers ? (
          <>
            <div
              class="
                flex
                items-center
                justify-end
                gap-size-3
                pb-size-6
                pt-size-4
                lg:gap-size-5
                lg:pb-size-8
              "
            >
              <div
                class="
    grid
    h-[22px]
    w-[48px]
    flex-none
    grid-cols-[1fr_auto_1fr]
    items-center
    whitespace-nowrap
    text-center
    text-[16px]
    font-normal
    leading-[1.4]
    tracking-[0]
    text-[#D5CABF]
    tabular-nums
  "
                aria-live="polite"
                aria-atomic="true"
              >
                <span data-speaker-counter class="text-right">
                  1
                </span>
                <span class="px-[2px]">de</span>
                <span class="text-left">{speakers.length}</span>
              </div>

              <Button
                variant="secondary"
                size="default"
                type="button"
                aria-label="Ponente anterior"
                class="speaker-prev w-[74px] px-0"
                disabled
              >
                <span class="text-2xl leading-none" aria-hidden="true">
                  ‹
                </span>
              </Button>

              <Button
                variant="secondary"
                size="default"
                type="button"
                aria-label="Siguiente ponente"
                class="speaker-next w-[74px] px-0"
              >
                <span class="text-2xl leading-none" aria-hidden="true">
                  ›
                </span>
              </Button>
            </div>

            <div
              class="
    speaker-carousel
    flex
    w-full
    gap-size-4
    overflow-x-hidden
    scroll-smooth
    pb-size-9
    pt-size-4
    sm:gap-size-5
    lg:gap-size-8
    lg:pb-size-10
  "
              role="region"
              aria-label="Carrusel de ponentes"
            >
              {speakers.map((speaker) => (
                <article
                  id={`speaker-${speaker.id}`}
                  class="
                    flex
                    min-h-[396px]
                    w-[280px]
                    flex-none
                    snap-start
                    flex-col
                    overflow-hidden
                    rounded-sm
                    border
border-[#272421]
bg-[#1A1814]
                    sm:w-[300px]
                    lg:h-[396px]
                    lg:w-[300px]
                  "
                  data-speaker-card
                >
                  <img
                    src={withBase(speaker.image)}
                    alt={`Retrato de ${speaker.name} ${speaker.lastName}`}
                    width="300"
                    height="300"
                    class="aspect-square w-full flex-none object-cover"
                    loading="lazy"
                  />

                  <div
                    class="
                      flex
                      min-h-[96px]
                      flex-1
                      flex-col
                      gap-size-1
                      p-size-4
                    "
                  >
                    <h3
                      class="
                        line-clamp-1
                        text-[15px]
                        font-bold
                        leading-tight
                        text-heading
                      "
                    >
                      {speaker.name} {speaker.lastName}
                    </h3>

                    <p
                      class="
                        line-clamp-1
                        text-[11px]
                        font-medium
                        leading-tight
                        text-muted
                      "
                    >
                      {speaker.role}
                    </p>
                  </div>
                </article>
              ))}
            </div>

            <div
              class="
    flex
    justify-end
    pb-size-7
    pt-size-10
    lg:pb-size-8
    lg:pt-size-11
  "
            >
              <GhostLink
                href={viewAllHref}
                label={viewAllLabel}
                class="
      text-xs
      font-semibold
      uppercase
      tracking-wide
      text-highlighted
    "
              />
            </div>
          </>
        ) : (
          <p class="py-size-8 type-paragraph-l text-muted">
            No hay ponentes disponibles.
          </p>
        )
      }
    </div>
  </Container>
</Section>

<script>
  function initializeSpeakersCarousels() {
    const sections = document.querySelectorAll<HTMLElement>(
      "[data-speakers-section]"
    );

    sections.forEach((section) => {
      if (section.dataset.initialized === "true") {
        return;
      }

      const carousel = section.querySelector<HTMLElement>(".speaker-carousel");

      const previousButton =
        section.querySelector<HTMLButtonElement>(".speaker-prev");

      const nextButton =
        section.querySelector<HTMLButtonElement>(".speaker-next");

      const counter = section.querySelector<HTMLElement>(
        "[data-speaker-counter]"
      );

      const cards = Array.from(
        section.querySelectorAll<HTMLElement>("[data-speaker-card]")
      );

      if (
        !carousel ||
        !previousButton ||
        !nextButton ||
        !counter ||
        cards.length === 0
      ) {
        return;
      }

      section.dataset.initialized = "true";

      let currentIndex = 0;
      let scrollFrame: number | undefined;

      const updateControls = () => {
        counter.textContent = String(currentIndex + 1);
        previousButton.disabled = currentIndex === 0;
        nextButton.disabled = currentIndex === cards.length - 1;
      };

      const scrollToCard = (index: number) => {
        currentIndex = Math.max(0, Math.min(index, cards.length - 1));

        cards[currentIndex].scrollIntoView({
          behavior: "smooth",
          block: "nearest",
          inline: "start",
        });

        updateControls();
      };

      const updateCurrentCard = () => {
        const carouselLeft = carousel.getBoundingClientRect().left;

        let closestIndex = 0;
        let closestDistance = Number.POSITIVE_INFINITY;

        cards.forEach((card, index) => {
          const distance = Math.abs(
            card.getBoundingClientRect().left - carouselLeft
          );

          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });

        if (closestIndex !== currentIndex) {
          currentIndex = closestIndex;
          updateControls();
        }
      };

      previousButton.addEventListener("click", () => {
        scrollToCard(currentIndex - 1);
      });

      nextButton.addEventListener("click", () => {
        scrollToCard(currentIndex + 1);
      });

      carousel.addEventListener(
        "scroll",
        () => {
          if (scrollFrame !== undefined) {
            cancelAnimationFrame(scrollFrame);
          }

          scrollFrame = requestAnimationFrame(updateCurrentCard);
        },
        { passive: true }
      );

      updateControls();
    });
  }

  initializeSpeakersCarousels();

  document.addEventListener("astro:page-load", initializeSpeakersCarousels);
</script>
