---
import Section from "../ui/Section.astro";

const slides = [
  { id: 1, title: "DevFest 2025", image: "", desc: "Gran cierre del evento." },
  { id: 2, title: "DevFest 2024", image: "", desc: "Apertura del evento." },
  { id: 3, title: "DevFest 2023", image: "", desc: "Próximamente." },
  { id: 4, title: "DevFest 2022", image: "", desc: "Próximamente." },
];
---

<Section
  class="carousel-section py-16 bg-page text-white overflow-hidden w-full max-w-[1200px] mx-auto text-center font-display [perspective:1000px]"
>
  <carousel-edition>
    <div
      class="carousel-container relative w-full max-w-[1040px] h-[465px] max-md:h-[350px] mx-auto flex justify-center items-center [transform-style:preserve-3d] touch-pan-y cursor-grab active:cursor-grabbing select-none"
    >
      {
        slides.map((slide, index) => (
          <div
            class="carousel-slide absolute w-[504px] h-[465px] max-md:w-[80%] max-md:h-auto max-md:aspect-[504/465] flex cursor-pointer blur-[0.8px] brightness-100 opacity-0 invisible z-1 transition-[transform,opacity] duration-600 ease-[cubic-bezier(0.25,1,0.5,1)]"
            data-index={index}
          >
            <div class="image-box bg-white w-full h-full flex items-center justify-center rounded-none text-sm shadow-[0_10px_30px_rgba(0,0,0,0.7)] transition-shadow duration-300 overflow-hidden">
              {slide.image ? (
                <img
                  src={slide.image}
                  alt="Edición anterior"
                  class="slide-img w-full h-full object-cover rounded-none"
                />
              ) : (
                <div class="placeholder-img w-full h-full bg-stone-300" />
              )}
            </div>
          </div>
        ))
      }
    </div>

    <!-- BOTONES  -->
    <div
      class="carousel-controls flex items-center justify-center gap-[12px] lg:gap-[16px] mt-8"
    >
      <button
        class="carousel-prev h-[30px] min-h-[30px] max-h-[30px] w-[74px] min-w-[74px] max-w-[74px] flex-none rounded-none border border-[#272421] bg-[#272421] p-0 text-stone-400 transition-colors cursor-pointer hover:bg-[var(--palette-amber-100)] hover:border-[var(--palette-amber-100)] hover:text-[#1A1814] active:bg-[var(--palette-amber-100)] active:border-[var(--palette-amber-100)] active:text-white disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-[#272421] disabled:hover:border-[#272421] disabled:hover:text-stone-400 lg:h-[43px] lg:min-h-[43px] lg:max-h-[43px] lg:w-[107px] lg:min-w-[107px] lg:max-w-[107px]"
        type="button"
        aria-label="Anterior"
      >
        <span class="flex h-full w-full items-center justify-center opacity-90">
          <svg
            width="25.5"
            height="25.5"
            viewBox="0 0 256 256"
            fill="none"
            class="h-[18px] w-[18px] rotate-180 lg:h-[25.5px] lg:w-[25.5px]"
            aria-hidden="true"
          >
            <path
              d="M40 128H216M144 56L216 128L144 200"
              stroke="currentColor"
              stroke-width="8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
      </button>

      <button
        class="carousel-next h-[30px] min-h-[30px] max-h-[30px] w-[74px] min-w-[74px] max-w-[74px] flex-none rounded-none border border-[#272421] bg-[#272421] p-0 text-stone-400 transition-colors cursor-pointer hover:bg-[var(--palette-amber-100)] hover:border-[var(--palette-amber-100)] hover:text-[#1A1814] active:bg-[var(--palette-amber-100)] active:border-[var(--palette-amber-100)] active:text-white disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-[#272421] disabled:hover:border-[#272421] disabled:hover:text-stone-400 lg:h-[43px] lg:min-h-[43px] lg:max-h-[43px] lg:w-[107px] lg:min-w-[107px] lg:max-w-[107px]"
        type="button"
        aria-label="Siguiente"
      >
        <span class="flex h-full w-full items-center justify-center opacity-90">
          <svg
            width="25.5"
            height="25.5"
            viewBox="0 0 256 256"
            fill="none"
            class="h-[18px] w-[18px] lg:h-[25.5px] lg:w-[25.5px]"
            aria-hidden="true"
          >
            <path
              d="M40 128H216M144 56L216 128L144 200"
              stroke="currentColor"
              stroke-width="8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
      </button>
    </div>
  </carousel-edition>
</Section>

<script>
  class EditionCarousel extends HTMLElement {
    currentIndex: number = 0;
    slides: HTMLElement[] = [];
    prevBtn: HTMLButtonElement | null = null;
    nextBtn: HTMLButtonElement | null = null;

    startX: number = 0;
    currentX: number = 0;
    isDragging: boolean = false;

    connectedCallback() {
      this.currentIndex = 0;
      this.slides = Array.from(
        this.querySelectorAll(".carousel-slide")
      ) as HTMLElement[];
      this.prevBtn = this.querySelector(".carousel-prev");
      this.nextBtn = this.querySelector(".carousel-next");
      if (this.slides.length > 0) {
        this.init();
      }
    }

    init() {
      this.updateCarousel();

      this.prevBtn?.addEventListener("click", () => this.navigate(-1));
      this.nextBtn?.addEventListener("click", () => this.navigate(1));

      this.slides.forEach((slide: HTMLElement, index: number) => {
        slide.addEventListener("click", () => {
          if (
            slide.classList.contains("prev") ||
            slide.classList.contains("next")
          ) {
            this.currentIndex = index;
            this.updateCarousel();
          }
        });
      });

      const container =
        (this.querySelector(".carousel-container") as HTMLElement) || this;

      // --- TOUCH (Mobile) ---
      container.addEventListener(
        "touchstart",
        (e: TouchEvent) => {
          this.startX = e.touches[0].clientX;
        },
        { passive: true }
      );

      container.addEventListener(
        "touchend",
        (e: TouchEvent) => {
          this.currentX = e.changedTouches[0].clientX;
          this.handleSwipe();
        },
        { passive: true }
      );

      // --- MOUSE DRAG (Desktop) ---
      container.addEventListener("mousedown", (e: MouseEvent) => {
        this.isDragging = true;
        this.startX = e.clientX;
        container.style.cursor = "grabbing";
      });

      window.addEventListener("mousemove", (e: MouseEvent) => {
        if (!this.isDragging) return;
        this.currentX = e.clientX;
      });

      window.addEventListener("mouseup", () => {
        if (!this.isDragging) return;
        this.isDragging = false;
        container.style.cursor = "grab";
        this.handleSwipe();
      });
    }

    handleSwipe() {
      const swipeDistance = this.currentX - this.startX;
      const swipeThreshold = 50;

      if (swipeDistance > swipeThreshold) {
        this.navigate(-1);
      } else if (swipeDistance < -swipeThreshold) {
        this.navigate(1);
      }
      this.startX = 0;
      this.currentX = 0;
    }

    navigate(direction: number) {
      this.currentIndex =
        (this.currentIndex + direction + this.slides.length) %
        this.slides.length;
      this.updateCarousel();
    }

    updateCarousel() {
      const isMobile = window.innerWidth <= 768;

      this.slides.forEach((slide: HTMLElement, index: number) => {
        slide.style.opacity = "0";
        slide.style.visibility = "hidden";
        slide.style.zIndex = "1";
        slide.style.pointerEvents = "auto";
        slide.style.filter = "blur(0.8px) brightness(1)";
        slide.classList.remove("active", "prev", "next", "hidden");

        if (index === this.currentIndex) {
          slide.classList.add("active");
          slide.style.opacity = "1";
          slide.style.visibility = "visible";
          slide.style.transform = "translateX(0) scale(1) translateZ(0)";
          slide.style.zIndex = "20";
          slide.style.cursor = "default";
          slide.style.filter = "blur(0) brightness(1)";
        } else if (
          index ===
          (this.currentIndex - 1 + this.slides.length) % this.slides.length
        ) {
          slide.classList.add("prev");
          slide.style.opacity = "1";
          slide.style.visibility = "visible";
          slide.style.transform = isMobile
            ? "translateX(-60%) scale(0.75) rotateY(10deg) translateZ(-50px)"
            : "translateX(-85%) scale(0.75) rotateY(15deg) translateZ(-100px)";
          slide.style.zIndex = "10";
        } else if (index === (this.currentIndex + 1) % this.slides.length) {
          slide.classList.add("next");
          slide.style.opacity = "1";
          slide.style.visibility = "visible";
          slide.style.transform = isMobile
            ? "translateX(60%) scale(0.75) rotateY(-10deg) translateZ(-50px)"
            : "translateX(85%) scale(0.75) rotateY(-15deg) translateZ(-100px)";
          slide.style.zIndex = "10";
        } else {
          slide.classList.add("hidden");
          slide.style.transform = "translateX(0) scale(0.4) translateZ(-200px)";
          slide.style.zIndex = "0";
          slide.style.pointerEvents = "none";
        }
      });
    }
  }
  customElements.define("carousel-edition", EditionCarousel);
</script>
