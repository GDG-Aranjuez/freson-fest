---
// PreviousEditions.astro
import Section from "../ui/Section.astro";

const slides = [
  { id: 1, title: "DevFest 2025", image: "", desc: "Gran cierre del evento." },
  { id: 2, title: "DevFest 2024", image: "", desc: "Apertura del evento." },
  { id: 3, title: "DevFest 2023", image: "", desc: "Próximamente." },
  { id: 4, title: "DevFest 2022", image: "", desc: "Próximamente." },
];
---

<Section class="carousel-section py-16 bg-black text-white overflow-hidden">
  <h2 class="main-title text-center text-3xl md:text-6xl font-semibold mb-12"
    >Lo que vivimos en ediciones anteriores</h2
  >

  <carousel-edition>
    <div class="carousel-container">
      {
        slides.map((slide, index) => (
          <div class="carousel-slide" data-index={index}>
            <div class="image-box">
              {slide.image ? (
                <img
                  src={slide.image}
                  alt="Edición anterior"
                  class="slide-img"
                />
              ) : (
                <div class="placeholder-img" />
              )}
            </div>
          </div>
        ))
      }
    </div>

    <div class="carousel-controls flex justify-center gap-2 mt-8">
      <button class="carousel-prev" type="button" aria-label="Anterior">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      </button>
      <button class="carousel-next" type="button" aria-label="Siguiente">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </div>
  </carousel-edition>
</Section>

<style>
  .carousel-section {
    padding: 4rem 1rem;
    font-family: var(--font-display);
    text-align: center;
    overflow: hidden;
    perspective: 1000px;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }
  .main-title {
    font-size: var(--font-size-highlight);
    color: var(--color-heading);
    font-weight: 600;
    margin-bottom: 3rem;
    text-align: center;
  }
  .carousel-container {
    position: relative;
    width: 100%;
    max-width: 1040px;
    height: 420px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    transform-style: preserve-3d;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
  }
  .carousel-container:active {
    cursor: grabbing;
  }
  .carousel-slide {
    position: absolute;
    width: 340px;
    aspect-ratio: 1/1;
    transition:
      transform 0.6s cubic-bezier(0.25, 1, 0.5, 1),
      opacity 0.6s ease-in-out,
      z-index 0s;
    opacity: 0;
    visibility: hidden;
    z-index: 1;
    display: flex;
    cursor: pointer;
    filter: blur(0.8px) brightness(1);
  }

  .carousel-slide.active {
    opacity: 1;
    visibility: visible;
    transform: translateX(0) scale(1.1) translateZ(0);
    z-index: 20;
    cursor: default;
    filter: blur(0) brightness(1);
  }
  .carousel-slide.prev {
    opacity: 1;
    visibility: visible;
    transform: translateX(-85%) scale(0.75) rotateY(15deg) translateZ(-100px);
    z-index: 10;
  }
  .carousel-slide.next {
    opacity: 1;
    visibility: visible;
    transform: translateX(85%) scale(0.75) rotateY(-15deg) translateZ(-100px);
    z-index: 10;
  }
  .carousel-slide.hidden {
    opacity: 0;
    visibility: hidden;
    transform: translateX(0) scale(0.4) translateZ(-200px);
    z-index: 0;
    pointer-events: none;
  }
  .image-box {
    background-color: white;
    width: 100%;
    height: 100%;
    aspect-ratio: 1/1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    font-size: 0.9rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
    transition: box-shadow 0.3s ease;
    overflow: hidden;
  }
  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
  }
  .carousel-controls {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }
  .carousel-controls button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 73.5px;
    height: 29.5px;
    padding: 2px 24px;
    cursor: pointer;
    background-color: var(--palette-stone-400);
    border: none;
    border-radius: 2px;
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .carousel-controls button:hover {
    background: var(--palette-orange-400);
  }

  @media (max-width: 768px) {
    .main-title {
      font-size: var(--font-size-h3-lg);
      line-height: 1.2;
      display: flex;
      flex-direction: column;
      margin-bottom: 2rem;
    }
    .carousel-container {
      height: 350px;
    }
    .carousel-slide {
      width: 50%;
    }
    .carousel-slide.prev {
      transform: translateX(-60%) scale(0.75) rotateY(10deg) translateZ(-50px);
    }
    .carousel-slide.next {
      transform: translateX(60%) scale(0.75) rotateY(-10deg) translateZ(-50px);
    }
    .carousel-controls button {
      width: 73.5px;
      height: 29.5px;
      padding: 2px 24px;
    }
  }
</style>

<script>
  class EditionCarousel extends HTMLElement {
    currentIndex: number = 0;
    slides: HTMLElement[] = [];
    prevBtn: HTMLButtonElement | null = null;
    nextBtn: HTMLButtonElement | null = null;

    startX: number = 0;
    currentX: number = 0;
    isDragging: boolean = false;

    connectedCallback() {
      this.currentIndex = 0;
      this.slides = Array.from(
        this.querySelectorAll(".carousel-slide")
      ) as HTMLElement[];
      this.prevBtn = this.querySelector(".carousel-prev");
      this.nextBtn = this.querySelector(".carousel-next");
      if (this.slides.length > 0) {
        this.init();
      }
    }

    init() {
      this.updateCarousel();

      this.prevBtn?.addEventListener("click", () => this.navigate(-1));
      this.nextBtn?.addEventListener("click", () => this.navigate(1));

      this.slides.forEach((slide: HTMLElement, index: number) => {
        slide.addEventListener("click", () => {
          if (
            slide.classList.contains("prev") ||
            slide.classList.contains("next")
          ) {
            this.currentIndex = index;
            this.updateCarousel();
          }
        });
      });

      const container =
        (this.querySelector(".carousel-container") as HTMLElement) || this;

      // --- TOUCH (Mobile) ---
      container.addEventListener(
        "touchstart",
        (e: TouchEvent) => {
          this.startX = e.touches[0].clientX;
        },
        { passive: true }
      );

      container.addEventListener(
        "touchend",
        (e: TouchEvent) => {
          this.currentX = e.changedTouches[0].clientX;
          this.handleSwipe();
        },
        { passive: true }
      );

      // --- MOUSE DRAG (Desktop) ---
      container.addEventListener("mousedown", (e: MouseEvent) => {
        this.isDragging = true;
        this.startX = e.clientX;
        container.style.cursor = "grabbing";
      });

      window.addEventListener("mousemove", (e: MouseEvent) => {
        if (!this.isDragging) return;
        this.currentX = e.clientX;
      });

      window.addEventListener("mouseup", () => {
        if (!this.isDragging) return;
        this.isDragging = false;
        container.style.cursor = "grab";
        this.handleSwipe();
      });
    }

    handleSwipe() {
      const swipeDistance = this.currentX - this.startX;
      const swipeThreshold = 50;

      if (swipeDistance > swipeThreshold) {
        this.navigate(-1);
      } else if (swipeDistance < -swipeThreshold) {
        this.navigate(1);
      }
      this.startX = 0;
      this.currentX = 0;
    }
    navigate(direction: number) {
      this.currentIndex =
        (this.currentIndex + direction + this.slides.length) %
        this.slides.length;
      this.updateCarousel();
    }
    updateCarousel() {
      this.slides.forEach((slide: HTMLElement, index: number) => {
        slide.classList.remove("active", "prev", "next", "hidden");
        if (index === this.currentIndex) {
          slide.classList.add("active");
        } else if (
          index ===
          (this.currentIndex - 1 + this.slides.length) % this.slides.length
        ) {
          slide.classList.add("prev");
        } else if (index === (this.currentIndex + 1) % this.slides.length) {
          slide.classList.add("next");
        } else {
          slide.classList.add("hidden");
        }
      });
    }
  }
  customElements.define("carousel-edition", EditionCarousel);
</script>
