---
import { BackgroundRippleEffect } from "@/components/ui/BackgroundRippleEffect.tsx";
import Countdown from "@/components/home/Countdown.astro";
import BenefitLink from "@/components/shared/BenefitLink.astro";
import CtaNote from "@/components/shared/CtaNote.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { hero } from "@/data/hero";
---

<Section
  class="relative bg-page overflow-hidden !py-size-13 lg:!pt-size-13 lg:!pb-size-15"
  ariaLabelledby="hero-heading"
>
  <div
    class="absolute inset-0 z-0 pointer-events-auto flex items-center justify-center"
  >
    <div class="relative w-full max-w-[1200px] h-full mx-auto px-0 sm:px-4">
      <BackgroundRippleEffect client:idle />
      <div
        class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-page pointer-events-none"
      ></div>
    </div>
  </div>

  <Container
    class="relative z-10 w-full max-w-[1200px] mx-auto pointer-events-none"
  >
    <div class="flex flex-col items-center text-center lg:gap-size-7">
      <div class="flex w-full max-w-[700px] flex-col items-center">
        <p
          class="type-eyebrow pb-size-6 text-subtitle w-full text-left lg:text-center"
        >
          <span class="font-light">{hero.dateLead}</span>
          {" "}
          <span class="font-medium">{hero.dateYear}</span>
        </p>

        <h1
          id="hero-heading"
          class="type-h1 max-w-[700px] pb-size-7 text-left lg:text-center"
        >
          <span class="text-heading">{hero.titleLead}{" "}</span>
          <span class="text-heading lg:text-highlighted">{" "}</span>
          <span class="text-highlighted">{hero.titleHighlight}</span>
        </h1>

        <p
          class="font-body type-subtitle max-w-[700px] pb-size-0 font-normal text-left lg:text-center"
        >
          {hero.subtitle}
        </p>

        <div class="flex w-full max-w-[422px] flex-col items-center">
          <div class="w-full pointer-events-auto">
            <Countdown
              class="w-full justify-center pb-size-10 pt-size-6 lg:pb-size-11"
            />
          </div>

          <div
            class="flex w-full max-w-[380px] flex-col items-center pointer-events-auto"
          >
            <CtaNote
              href={hero.cta.href}
              label={hero.cta.label}
              footnote={hero.footnote}
              noteAlign="center"
            />
          </div>

          <div class="flex w-full justify-center pt-size-6 pointer-events-auto">
            <BenefitLink href={hero.benefit.href} label={hero.benefit.label} />
          </div>
        </div>
      </div>
    </div>
  </Container>
</Section>
