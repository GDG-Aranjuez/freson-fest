---
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { locationSection } from "@/data/location";
import { withBase } from "@/utils/path";
---

<Section class="bg-page font-body" ariaLabelledby="location-heading">
  <Container class="max-w-[1200px] mx-auto px-size-6 lg:px-size-13 py-size-13">
    <div
      class="mx-auto flex w-full max-w-[1200px] flex-col lg:grid lg:grid-cols-2 lg:items-start lg:justify-between lg:gap-x-12"
    >
      <!-- Columna Izquierda (Texto e Instrucciones) -->
      <div class="flex flex-col">
        <header class="pb-size-6 lg:pb-size-8">
          {/* Eyebrow: 15px en mobile, 18px en desktop */}
          <p
            class="type-eyebrow-medium pb-size-6 uppercase text-highlighted text-[15px] lg:text-[18px] leading-tight"
          >
            {locationSection.eyebrow}
          </p>

          {/* Título: 32px en mobile, 40px en desktop */}
          <h2
            id="location-heading"
            class="type-h4 text-[32px] lg:text-[40px] pb-size-5 lg:pb-size-7 leading-tight"
          >
            {locationSection.heading}
          </h2>

          {
            /* Dirección y Venue: 14px en mobile, tamaño por defecto en desktop */
          }
          <address
            class="type-paragraph-m not-italic text-body space-y-1 text-[14px] lg:text-base leading-normal"
          >
            <span class="block text-body font-medium text-[14px] lg:text-base"
              >{locationSection.venue}</span
            >
            {
              locationSection.addressLines.map((line) => (
                <span class="block text-body text-[14px] lg:text-base">
                  {line}
                </span>
              ))
            }
          </address>
        </header>

        <!-- Bloque Mapa + Botón (Mobile) -->
        <div
          class="flex flex-col items-center gap-4 my-size-6 lg:hidden w-full"
        >
          <div
            class="relative h-[220px] w-full max-w-[358px] overflow-hidden rounded-sm"
          >
            <iframe
              title={locationSection.map.title}
              src={locationSection.map.embedSrc}
              class="absolute inset-0 size-full border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen></iframe>
          </div>

          <Button
            href={locationSection.cta.href}
            variant="secondary"
            external
            class="font-body w-full max-w-[358px] h-[56px] flex items-center justify-center text-center text-[15px]"
          >
            {locationSection.cta.label}
          </Button>
        </div>

        <!-- Instrucciones (Lista de transporte): 14px en mobile, tamaño por defecto en desktop -->
        <ul
          class="flex list-none flex-col p-0 py-size-6 lg:pb-size-9 lg:pt-size-6 space-y-2"
        >
          {
            locationSection.instructions.map((item) => (
              <li class="flex items-center gap-size-4 py-size-2">
                <span
                  class="inline-flex size-5 shrink-0 items-center justify-center overflow-clip"
                  aria-hidden="true"
                >
                  {"icon" in item ? (
                    <img
                      src={withBase(item.icon.src)}
                      alt={item.icon.alt}
                      width="20"
                      height="20"
                      class="size-full object-contain"
                    />
                  ) : (
                    <span class="type-caption w-full text-center font-medium text-body text-[14px] lg:text-caption">
                      {item.letter}
                    </span>
                  )}
                </span>
                <span class="type-paragraph-s text-body text-[14px] lg:text-paragraph-s leading-normal">
                  {item.label}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna Derecha: Mapa + Botón (Desktop) -->
      <div class="hidden lg:flex flex-col gap-4 w-full">
        <div class="relative h-[300px] w-full overflow-hidden rounded-sm">
          <iframe
            title={locationSection.map.title}
            src={locationSection.map.embedSrc}
            class="absolute inset-0 size-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>

        <Button
          href={locationSection.cta.href}
          variant="secondary"
          external
          class="font-body"
        >
          {locationSection.cta.label}
        </Button>
      </div>
    </div>
  </Container>
</Section>
