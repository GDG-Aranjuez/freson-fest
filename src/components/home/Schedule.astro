---
import GhostLink from "@/components/shared/GhostLink.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { agenda, homeSchedule } from "@/data/agenda";

const eyebrow = homeSchedule.eyebrow;
const heading = homeSchedule.heading;
const cta = homeSchedule.cta;
const allSessions = agenda.days[0]?.sessions ?? [];
const talks = allSessions.filter(
  (session) => session.type === "Charla" || session.type === "Panel"
);

const workshops = allSessions.filter((session) => session.type === "Taller");
---

<Section
  class="!py-size-13 lg:!py-size-15"
  ariaLabelledby="home-agenda-heading"
>
  <Container>
    <div class="mx-auto w-full max-w-[1040px]">
      <header class="pb-size-8 lg:pb-size-10">
        <p
          class="inline-flex items-center pb-size-3 font-body text-[15px] font-light uppercase tracking-normal text-brand md:text-[18px] md:font-medium"
        >
          {eyebrow}
        </p>
        <h2
          id="home-agenda-heading"
          class="font-display text-[40px] font-semibold leading-[1.1] text-heading md:text-[64px]"
        >
          {heading}
        </h2>
      </header>

      <div class="relative w-full">
        {/* Pestañas (Tabs) */}
        <div class="flex gap-1 md:gap-1" role="tablist">
          <button
            id="tab-charlas"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="panel-charlas"
            data-tab-btn="charlas"
            class="tab-trapezoid relative z-10 flex h-[56px] w-[256px] cursor-pointer items-center justify-center bg-surface font-display text-[18px] font-medium leading-[1.1] text-heading transition-colors lg:text-[20px]"
          >
            Charlas
          </button>
          <button
            id="tab-workshops"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-workshops"
            data-tab-btn="workshops"
            class="tab-trapezoid relative z-0 flex h-[56px] w-[256px] cursor-pointer items-center justify-center bg-[#171512] font-display text-[18px] font-medium leading-[1.1] text-subtitle transition-colors hover:text-heading lg:text-[20px]"
          >
            Workshops
          </button>
        </div>
        <div class="relative z-10 border border-stroke-strong/30 bg-surface">
          {/* Panel Charlas */}
          <div
            id="panel-charlas"
            role="tabpanel"
            aria-labelledby="tab-charlas"
            data-tab-panel="charlas"
            class="p-6 md:p-8"
          >
            <div class="flex flex-col space-y-4">
              {
                talks.map((session) => (
                  <details class="group relative cursor-pointer border border-transparent p-5 transition-all duration-300 ease-out hover:z-30 hover:scale-[1.035] hover:border-brand hover:bg-white/[0.02] hover:shadow-[0_8px_30px_rgba(255,158,102,0.18)] open:z-20 open:border-brand open:bg-white/[0.01]">
                    <summary class="flex w-full list-none items-start justify-between gap-4 [&::-webkit-details-marker]:hidden">
                      <div class="flex items-start gap-4 md:gap-8">
                        <time class="w-[90px] shrink-0 font-body text-[16px] font-medium text-brand md:w-[110px] md:text-[18px]">
                          {session.startTime}
                        </time>
                        <div>
                          <h3 class="font-display text-[18px] font-medium leading-[1.1] text-heading md:text-[22px]">
                            {session.title}
                          </h3>
                          {session.speaker && (
                            <p class="pt-1 font-body text-[14px] font-normal leading-[1.2] text-subtitle md:text-[18px]">
                              {session.speaker}
                            </p>
                          )}
                        </div>
                      </div>
                      <span class="text-[18px] font-light text-[#FF9E66] transition-transform duration-300 group-open:rotate-45">
                        +
                      </span>
                    </summary>
                    {session.description && (
                      <div class="pt-4 pl-[106px] md:pl-[142px] font-body text-[14px] leading-relaxed text-subtitle md:text-[16px]">
                        <p>{session.description}</p>
                      </div>
                    )}
                  </details>
                ))
              }
            </div>
          </div>

          {/* Panel Workshops */}
          <div
            id="panel-workshops"
            role="tabpanel"
            aria-labelledby="tab-workshops"
            data-tab-panel="workshops"
            class="hidden p-6 md:p-8"
          >
            <div class="flex flex-col space-y-4">
              {
                workshops.map((session) => (
                  <details class="group relative cursor-pointer border border-transparent p-5 transition-all duration-300 ease-out hover:z-30 hover:scale-[1.035] hover:border-brand hover:bg-white/[0.02] hover:shadow-[0_8px_30px_rgba(255,158,102,0.18)] open:z-20 open:border-brand open:bg-white/[0.01]">
                    <summary class="flex w-full list-none items-start justify-between gap-4 [&::-webkit-details-marker]:hidden">
                      <div class="flex items-start gap-4 md:gap-8">
                        <time class="w-[90px] shrink-0 font-body text-[16px] font-medium text-brand md:w-[110px] md:text-[18px]">
                          {session.startTime}
                        </time>
                        <div>
                          <h3 class="font-display text-[18px] font-medium leading-[1.1] text-heading md:text-[22px]">
                            {session.title}
                          </h3>
                          {session.speaker && (
                            <p class="pt-1 font-body text-[14px] font-normal leading-[1.2] text-subtitle md:text-[18px]">
                              {session.speaker}
                            </p>
                          )}
                        </div>
                      </div>
                      <span class="text-[18px] font-light text-[#FF9E66] transition-transform duration-300 group-open:rotate-45">
                        +
                      </span>
                    </summary>
                    {session.description && (
                      <div class="pt-4 pl-[106px] md:pl-[142px] font-body text-[14px] leading-relaxed text-subtitle md:text-[16px]">
                        <p>{session.description}</p>
                      </div>
                    )}
                  </details>
                ))
              }
            </div>
          </div>

          <div
            class="flex justify-end border-t border-stroke-strong/20 bg-surface px-6 py-4"
          >
            <GhostLink href={cta.href} label={cta.label} />
          </div>
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  .tab-trapezoid {
    clip-path: polygon(14px 0, calc(100% - 14px) 0, 100% 100%, 0 100%);
  }
</style>

<script>
  function initializeAgendaTabs() {
    const tabBtns =
      document.querySelectorAll<HTMLButtonElement>("[data-tab-btn]");
    const tabPanels =
      document.querySelectorAll<HTMLElement>("[data-tab-panel]");

    tabBtns.forEach((btn) => {
      if (btn.dataset.initialized === "true") return;
      btn.dataset.initialized = "true";

      btn.addEventListener("click", () => {
        const target = btn.dataset.tabBtn;

        tabBtns.forEach((b) => {
          const isSelected = b === btn;
          b.setAttribute("aria-selected", String(isSelected));

          if (isSelected) {
            b.classList.remove("bg-[#171512]", "text-subtitle", "z-0");
            b.classList.add("bg-surface", "text-heading", "z-10");
          } else {
            b.classList.remove("bg-surface", "text-heading", "z-10");
            b.classList.add("bg-[#171512]", "text-subtitle", "z-0");
          }
        });

        tabPanels.forEach((panel) => {
          if (panel.dataset.tabPanel === target) {
            panel.classList.remove("hidden");
          } else {
            panel.classList.add("hidden");
          }
        });
      });
    });
  }

  initializeAgendaTabs();
  document.addEventListener("astro:page-load", initializeAgendaTabs);
</script>
