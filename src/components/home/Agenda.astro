---
import GhostLink from "@/components/shared/GhostLink.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { agenda as defaultAgenda } from "@/data/agenda";
import type { AgendaSession } from "@/types/agenda";

interface Props {
  class?: string;
  eyebrow?: string;
  heading?: string;
  description?: string;
  cta?: {
    href: string;
    label: string;
  };
  secondaryLink?: {
    href: string;
    label: string;
  };
}

const {
  class: className = "",
  eyebrow = defaultAgenda.eyebrow,
  heading = defaultAgenda.headline,
  description = defaultAgenda.description,
  cta = defaultAgenda.cta,
  secondaryLink = defaultAgenda.secondaryLink,
} = Astro.props;

const allSessions = defaultAgenda.days[0]?.sessions ?? [];
const talks = allSessions.filter(
  (session: AgendaSession) =>
    session.type === "Charla" || session.type === "Panel"
);
const workshops = allSessions.filter(
  (session: AgendaSession) => session.type === "Taller"
);
---

<Section
  class={`!py-size-13 lg:!py-size-15 ${className}`}
  ariaLabelledby="home-agenda-heading"
>
  <Container>
    <div class="mx-auto w-full max-w-[1040px]">
      <header class="pb-size-8 lg:pb-size-10">
        {
          eyebrow && (
            <p class="inline-flex items-center pb-size-3 font-body text-[15px] font-light uppercase tracking-normal text-brand md:text-[18px] md:font-medium">
              {eyebrow}
            </p>
          )
        }
        <h2
          id="home-agenda-heading"
          class="font-display text-[40px] font-semibold leading-[1.1] text-heading md:text-[64px]"
        >
          {heading}
        </h2>
        {
          description && (
            <p class="pt-3 font-body text-[16px] text-subtitle md:text-[18px]">
              {description}
            </p>
          )
        }
      </header>

      <div class="relative w-full">
        {/* Pestañas (Tabs) */}
        <div class="flex gap-1 md:gap-1" role="tablist">
          <button
            id="tab-charlas"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="panel-charlas"
            data-tab-btn="charlas"
            class="tab-trapezoid relative z-10 flex h-[56px] w-[256px] cursor-pointer items-center justify-center bg-surface font-display text-[18px] font-medium leading-[1.1] text-heading transition-colors lg:text-[20px]"
          >
            Charlas
          </button>
          <button
            id="tab-workshops"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-workshops"
            data-tab-btn="workshops"
            class="tab-trapezoid relative z-0 flex h-[56px] w-[256px] cursor-pointer items-center justify-center bg-[#171512] font-display text-[18px] font-medium leading-[1.1] text-subtitle transition-colors hover:text-heading lg:text-[20px]"
          >
            Workshops
          </button>
        </div>

        {/* Contenedor principal de 1040px */}
        <div class="relative z-10 border border-stroke-strong/30 bg-surface">
          {/* Panel Charlas */}
          <div
            id="panel-charlas"
            role="tabpanel"
            aria-labelledby="tab-charlas"
            data-tab-panel="charlas"
            class="p-0"
          >
            <div class="flex flex-col">
              {
                talks.map((session: AgendaSession) => (
                  <div class="group relative min-h-[126px] w-full cursor-pointer border border-transparent border-b-stroke-strong/20 px-8 py-6 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:z-30 hover:-translate-y-1.5 hover:scale-[1.015] hover:border-brand hover:bg-[#1a1714] hover:shadow-[0_10px_30px_rgba(255,158,102,0.22)]">
                    <div class="flex min-h-[78px] w-full items-center justify-between gap-4">
                      <div class="flex items-center gap-6 md:gap-10">
                        <time class="w-[90px] shrink-0 font-body text-[16px] font-medium text-brand md:w-[110px] md:text-[18px]">
                          {session.startTime}
                        </time>
                        <div>
                          <h3 class="font-display text-[18px] font-medium leading-[1.1] text-heading md:text-[22px]">
                            {session.title}
                          </h3>
                          {session.speaker && (
                            <p class="pt-1 font-body text-[14px] font-normal leading-[1.2] text-subtitle md:text-[18px]">
                              {session.speaker}
                            </p>
                          )}
                        </div>
                      </div>

                      {/* Signo + (Deshabilitado temporalmente)
                      <span class="text-[18px] font-light text-[#FF9E66] transition-transform duration-200 group-open:rotate-45">
                        +
                      </span>
                      */}
                    </div>

                    {/* Información desplegable (Deshabilitado temporalmente)
                    {session.description && (
                      <div class="pt-4 pl-[114px] md:pl-[150px] font-body text-[14px] leading-relaxed text-subtitle md:text-[16px]">
                        <p>{session.description}</p>
                      </div>
                    )}
                    */}
                  </div>
                ))
              }
            </div>
          </div>

          {/* Panel Workshops */}
          <div
            id="panel-workshops"
            role="tabpanel"
            aria-labelledby="tab-workshops"
            data-tab-panel="workshops"
            class="hidden p-0"
          >
            <div class="flex flex-col">
              {
                workshops.map((session: AgendaSession) => (
                  <div class="group relative min-h-[126px] w-full cursor-pointer border border-transparent border-b-stroke-strong/20 px-8 py-6 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:z-30 hover:-translate-y-1.5 hover:scale-[1.015] hover:border-brand hover:bg-[#1a1714] hover:shadow-[0_10px_30px_rgba(255,158,102,0.22)]">
                    <div class="flex min-h-[78px] w-full items-center justify-between gap-4">
                      <div class="flex items-center gap-6 md:gap-10">
                        <time class="w-[90px] shrink-0 font-body text-[16px] font-medium text-brand md:w-[110px] md:text-[18px]">
                          {session.startTime}
                        </time>
                        <div>
                          <h3 class="font-display text-[18px] font-medium leading-[1.1] text-heading md:text-[22px]">
                            {session.title}
                          </h3>
                          {session.speaker && (
                            <p class="pt-1 font-body text-[14px] font-normal leading-[1.2] text-subtitle md:text-[18px]">
                              {session.speaker}
                            </p>
                          )}
                        </div>
                      </div>

                      {/* Signo + (Deshabilitado temporalmente)
                      <span class="text-[18px] font-light text-[#FF9E66] transition-transform duration-200 group-open:rotate-45">
                        +
                      </span>
                      */}
                    </div>

                    {/* Información desplegable (Deshabilitado temporalmente)
                    {session.description && (
                      <div class="pt-4 pl-[114px] md:pl-[150px] font-body text-[14px] leading-relaxed text-subtitle md:text-[16px]">
                        <p>{session.description}</p>
                      </div>
                    )}
                    */}
                  </div>
                ))
              }
            </div>
          </div>

          {/* Footer / Enlaces CTA */}
          {
            (cta || secondaryLink) && (
              <div class="flex flex-col gap-4 border-t border-stroke-strong/20 bg-surface px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
                {cta && <GhostLink href={cta.href} label={cta.label} />}
                {secondaryLink && (
                  <GhostLink
                    href={secondaryLink.href}
                    label={secondaryLink.label}
                    class="text-[var(--color-action-ghost-text)] gap-2"
                  />
                )}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  .tab-trapezoid {
    clip-path: polygon(14px 0, calc(100% - 14px) 0, 100% 100%, 0 100%);
  }
</style>

<script>
  function initializeAgendaTabs() {
    const tabBtns =
      document.querySelectorAll<HTMLButtonElement>("[data-tab-btn]");
    const tabPanels =
      document.querySelectorAll<HTMLElement>("[data-tab-panel]");

    tabBtns.forEach((btn) => {
      if (btn.dataset.initialized === "true") return;
      btn.dataset.initialized = "true";

      btn.addEventListener("click", () => {
        const target = btn.dataset.tabBtn;

        tabBtns.forEach((b) => {
          const isSelected = b === btn;
          b.setAttribute("aria-selected", String(isSelected));

          if (isSelected) {
            b.classList.remove("bg-[#171512]", "text-subtitle", "z-0");
            b.classList.add("bg-surface", "text-heading", "z-10");
          } else {
            b.classList.remove("bg-surface", "text-heading", "z-10");
            b.classList.add("bg-[#171512]", "text-subtitle", "z-0");
          }
        });

        tabPanels.forEach((panel) => {
          if (panel.dataset.tabPanel === target) {
            panel.classList.remove("hidden");
          } else {
            panel.classList.add("hidden");
          }
        });
      });
    });
  }

  initializeAgendaTabs();
  document.addEventListener("astro:page-load", initializeAgendaTabs);
</script>
