---
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import { aboutHistory } from "@/data/about";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<Section
  class:list={["!py-size-13 lg:!pb-size-15", className]}
  ariaLabelledby="about-history-heading"
>
  <Container>
    <header
      class="flex max-w-[700px] flex-col items-start py-size-8 lg:mx-auto lg:max-w-[750px] lg:items-center lg:text-center"
    >
      <p
        class="pb-size-6 font-body text-[15px] font-light uppercase leading-none text-highlighted lg:text-[18px] lg:font-medium"
      >
        {aboutHistory.eyebrow}
      </p>
      <h2 id="about-history-heading" class="type-h2 pb-size-7 text-heading">
        {aboutHistory.title}
      </h2>
      <p
        class="font-body text-[16px] leading-[1.4] text-subtitle lg:text-[20px] lg:leading-[1.2]"
      >
        {aboutHistory.body}
      </p>
    </header>
  </Container>
</Section>
