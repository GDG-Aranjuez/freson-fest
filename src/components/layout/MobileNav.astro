---
import Button from "@/components/ui/Button.astro";
import CloseIcon from "@/components/ui/CloseIcon.astro";
import { isActive } from "@/utils/nav";
import { withBase } from "@/utils/path";
import type { NavLink } from "@/types/nav";

interface Props {
  links: NavLink[];
  pathname: string;
  ticketsHref: string;
  ticketsLabel: string;
}

const { links, pathname, ticketsHref, ticketsLabel } = Astro.props;
const linkBase =
  "flex h-12 w-full items-center justify-center font-body text-base font-medium leading-none";
---

<div
  id="nav-mobile"
  class="hidden lg:hidden fixed inset-0 z-[80] bg-page overflow-hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
>
  <div class="flex h-dvh w-full flex-col px-size-7 pt-size-6 pb-size-12">
    <div class="flex h-12 w-full shrink-0 items-center justify-end">
      <button
        id="nav-close"
        type="button"
        class="flex size-6 items-center justify-center text-heading transition-colors hover:text-brand"
        aria-label="Cerrar menú"
      >
        <CloseIcon class="size-6" />
      </button>
    </div>

    <nav
      class="flex min-h-0 w-full flex-1 flex-col items-center"
      aria-label="Navegación móvil"
    >
      <div class="flex w-full max-w-xs flex-col items-center gap-size-7 overflow-y-auto pt-size-10">
        {links.map(({ href, label }) => {
          const active = isActive(pathname, href);
          return (
            <a
              href={withBase(href)}
              class:list={[
                linkBase,
                active ? "text-brand" : "text-heading hover:text-brand",
              ]}
              aria-current={active ? "page" : undefined}
            >
              {label}
            </a>
          );
        })}
      </div>
      <div class="min-h-size-8 w-full flex-1"></div>
      <Button
        href={ticketsHref}
        size="small"
        block
        class="h-12 w-full max-w-[15.25rem] shrink-0"
      >
        {ticketsLabel}
      </Button>
    </nav>
  </div>
</div>

<script>
  function initMobileNav() {
    const toggle = document.getElementById("nav-toggle");
    const closeBtn = document.getElementById("nav-close");
    const menu = document.getElementById("nav-mobile");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");

    if (!toggle || !closeBtn || !menu || !iconOpen || !iconClose) return;

    if (toggle.dataset.bound === "true") return;
    toggle.dataset.bound = "true";

    function setOpen(open: boolean) {
      toggle?.setAttribute("aria-expanded", String(open));
      toggle?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      menu?.classList.toggle("hidden", !open);
      iconOpen?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
      document.body.classList.toggle("overflow-hidden", open);
      document.documentElement.style.overflow = open ? "hidden" : "";
      document.querySelector("header")?.classList.toggle("invisible", open);
    }

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    closeBtn.addEventListener("click", () => setOpen(false));

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        toggle.getAttribute("aria-expanded") === "true"
      ) {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  initMobileNav();

  document.addEventListener("astro:page-load", () => {
    document.body.classList.remove("overflow-hidden");
    document.documentElement.style.overflow = "";
    document.querySelector("header")?.classList.remove("invisible");
    initMobileNav();
  });
</script>
