---
import DesktopNav from "@/components/layout/DesktopNav.astro";
import MobileNav from "@/components/layout/MobileNav.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import { mainNavLinks, ticketsCta } from "@/data/nav";
import { withBase } from "@/utils/path";

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full bg-page font-body">
  <Container
    class="flex items-center justify-between pt-size-7 pb-size-2 lg:py-size-6"
  >
    <a href={withBase("/")} class="shrink-0 flex items-center">
      <img
        src={withBase("/brand/imagotipo-navbar.svg")}
        alt="FresON fest"
        width="110"
        height="43"
        class="h-10 w-auto lg:h-[43px]"
      />
    </a>

    <DesktopNav links={mainNavLinks} pathname={pathname}>
      <Button href={ticketsCta.href} size="small">
        {ticketsCta.label}
      </Button>
    </DesktopNav>

    <!-- Botón alineado exactamente a la derecha -->
    <button
      id="nav-toggle"
      type="button"
      class="lg:hidden flex items-center justify-end p-0 size-size-11 text-heading hover:text-link transition-colors"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="nav-mobile"
    >
      <svg
        id="icon-open"
        width="36"
        height="36"
        viewBox="0 0 36 36"
        fill="currentColor"
        aria-hidden="true"
      >
        <g transform="translate(4.78125 8.15625)">
          <path
            d="M26.4375 9.84375C26.4375 10.0675 26.3486 10.2821 26.1904 10.4404C26.0321 10.5986 25.8175 10.6875 25.5938 10.6875H0.84375C0.619974 10.6875 0.405362 10.5986 0.247129 10.4404C0.0888947 10.2821 0 10.0675 0 9.84375C0 9.61997 0.0888947 9.40536 0.247129 9.24713C0.405362 9.0889 0.619974 9 0.84375 9H25.5938C25.8175 9 26.0321 9.0889 26.1904 9.24713C26.3486 9.40536 26.4375 9.61997 26.4375 9.84375ZM0.84375 1.6875H25.5938C25.8175 1.6875 26.0321 1.5986 26.1904 1.44037C26.3486 1.28214 26.4375 1.06753 26.4375 0.84375C26.4375 0.619974 26.3486 0.405362 26.1904 0.247129C26.0321 0.0888947 25.8175 0 25.5938 0H0.84375C0.619974 0 0.405362 0.0888947 0.247129 0.247129C0.0888947 0.405362 0 0.619974 0 0.84375C0 1.06753 0.0888947 1.28214 0.247129 1.44037C0.405362 1.5986 0.619974 1.6875 0.84375 1.6875ZM25.5938 18H0.84375C0.619974 18 0.405362 18.0889 0.247129 18.2471C0.0888947 18.4054 0 18.62 0 18.8438C0 19.0675 0.0888947 19.2821 0.247129 19.4404C0.405362 19.5986 0.619974 19.6875 0.84375 19.6875H25.5938C25.8175 19.6875 26.0321 19.5986 26.1904 19.4404C26.3486 19.2821 26.4375 19.0675 26.4375 18.8438C26.4375 18.62 26.3486 18.4054 26.1904 18.2471C26.0321 18.0889 25.8175 18 25.5938 18Z"
          ></path>
        </g>
      </svg>
      <svg
        id="icon-close"
        width="36"
        height="36"
        viewBox="0 0 36 36"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        class="hidden"
        aria-hidden="true"
      >
        <path d="M9 9l18 18M27 9L9 27"></path>
      </svg>
    </button>
  </Container>
</header>

<MobileNav
  links={mainNavLinks}
  pathname={pathname}
  ticketsHref={ticketsCta.href}
  ticketsLabel={ticketsCta.label}
/>
