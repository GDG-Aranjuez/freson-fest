---
import HeroSplit from "@/components/blocks/HeroSplit.astro";
import History from "@/components/blocks/History.astro";
import JoinTeam from "@/components/blocks/JoinTeam.astro";
import Location from "@/components/blocks/Location.astro";
import Stats from "@/components/blocks/Stats.astro";
import Team from "@/components/blocks/Team.astro";
import { hero, history, join, stats } from "@/data/about";
import { locationSection } from "@/data/location";
import { team } from "@/data/team";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Nosotros"
  description="Conoce al equipo de GDG Aranjuez detrás de Fresón Fest 2026: una comunidad que acerca la tecnología a Aranjuez y a Madrid Sur."
>
  <HeroSplit
    headingId="about-hero-heading"
    eyebrow={hero.eyebrow}
    title={hero.title}
    subtitle={hero.subtitle}
    image={hero.image}
  />
  <div class="flex flex-col">
    <History
      class="order-2 lg:order-3"
      eyebrow={history.eyebrow}
      title={history.title}
      body={history.body}
    />
    <Stats class="order-3 lg:order-2" stats={stats} />
  </div>
  <Team title={team.title} groups={team.groups} />
  <Location location={locationSection} />
  <JoinTeam
    eyebrow={join.eyebrow}
    title={join.title}
    subtitle={join.subtitle}
    cta={join.cta}
  />
</BaseLayout>
