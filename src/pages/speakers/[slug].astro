---
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { speakers } from "@/data/speakers";

export function getStaticPaths() {
  return speakers.map((speaker) => ({
    params: { slug: speaker.name.toLowerCase().replace(/\s+/g, "-") },
    props: { speaker },
  }));
}

const { speaker } = Astro.props;
---

<BaseLayout
  title={speaker.name}
  description={`${speaker.role} en GDG Aranjuez`}
>
  <Section class="bg-page">
    <Container>
      <div class="mx-auto w-full max-w-[900px]">
        <!-- Breadcrumb -->
        <nav class="mb-size-8" aria-label="Breadcrumb">
          <ol class="flex items-center gap-size-2 type-paragraph-s text-muted">
            <li
              ><a href="/" class="text-brand hover:text-brand-hover">Inicio</a
              ></li
            >
            <li>/</li>
            <li
              ><a href="/speakers" class="text-brand hover:text-brand-hover"
                >Speakers</a
              ></li
            >
            <li>/</li>
            <li class="text-heading">{speaker.name}</li>
          </ol>
        </nav>

        <!-- Header del ponente -->
        <div class="mb-size-12">
          <!-- Información del ponente -->
          <div>
            <p
              class="type-eyebrow-medium pb-size-4 text-brand uppercase tracking-wider"
              >{speaker.role}</p
            >

            <h1 class="type-h2 pb-size-4 text-heading">{speaker.name}</h1>
          </div>
        </div>

        <!-- Back button -->
        <div class="mt-size-12">
          <a
            href="/speakers"
            class="type-paragraph-s text-brand hover:text-brand-hover transition-colors inline-flex items-center gap-size-2"
          >
            ← Volver a speakers
          </a>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
