---
import FaqList from "@/components/blocks/FaqList.astro";
import HeroRipple from "@/components/blocks/HeroRipple.astro";
import SpeakerList from "@/components/blocks/SpeakerList.astro";
import { previewFaqs } from "@/data/faqs";
import { talkForSpeaker } from "@/data/agenda";
import { hero, speakers } from "@/data/speakers";
import { ticketCtas } from "@/data/tickets";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Speakers">
  <HeroRipple
    headingId="speakers-hero-heading"
    class="relative overflow-hidden bg-page !py-size-13 lg:!py-0"
  >
    <div class="mx-auto flex w-full max-w-[343px] flex-col items-center text-center lg:min-h-[500px] lg:max-w-[700px] lg:justify-center">
      <p class="pb-0 text-center font-body text-[15px] font-medium uppercase leading-none tracking-normal text-brand lg:hidden">
        {hero.eyebrow}
      </p>

      <h1
        id="speakers-hero-heading"
        class="type-h1 mt-size-4 w-full text-center lg:mt-0 lg:leading-[0.8]"
      >
        <span class="block">{hero.title}</span>
        <span class="block text-highlighted">{hero.highlightedTitle}</span>
      </h1>
    </div>
  </HeroRipple>

  <SpeakerList
    speakers={speakers.map((speaker) => ({
      speaker,
      talk: talkForSpeaker(speaker.id),
    }))}
    heading={hero.ourSpeakersLabel}
    ticketsCta={ticketCtas.primary}
    ticketsFootnote={ticketCtas.primary.footnote}
  />

  <FaqList
    headingId="speakers-faqs-heading"
    heading={previewFaqs.heading}
    subtitle={previewFaqs.subtitle}
    items={previewFaqs.items}
    more={previewFaqs.more}
  />
</BaseLayout>
