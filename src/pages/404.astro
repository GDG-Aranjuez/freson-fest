---
import ComingSoon from "@/components/blocks/ComingSoon.astro";
import { comingSoonContent } from "@/data/coming-soon";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o aún no está disponible."
  noindex
>
  <ComingSoon
    heading="Página no encontrada"
    description="La página que buscas no existe o aún no está disponible."
    backHref={comingSoonContent.backHref}
    backLabel={comingSoonContent.backLabel}
  />
</BaseLayout>
